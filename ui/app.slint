    in-out property <string> batch-export-prefix: "Export ";
    in-out property <string> batch-export-suffix: " MP4";

    // people / faces
    in-out property <string> people-subtitle: "Recognized faces and cross-camera tracking on your H500 HomeBase.";
    in-out property <string> people-all-option: "All people";
    in-out property <string> people-familiar: "Familiar";
    in-out property <string> people-stranger: "Stranger";
