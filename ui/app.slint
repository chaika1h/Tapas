import { AboutSlint, Button, LineEdit, ComboBox, CheckBox, Slider, ScrollView, GroupBox, Spinner, Palette, ListView, Switch } from "std-widgets.slint";

export enum Page { home, live, single, recordings, settings }

export struct Tile {
    id: int,
    name: string,
    frame: image,
    has-frame: bool,
    status: string,
    live: bool,
    // The frame is the camera's last picture, shown until live video comes.
    stale: bool,
    audio-on: bool,
}

// A camera on Home: `detail` is its model, `room` its room in the Tapo
// app; `playback` when a hub records it.
export struct HomeCard { id: int, name: string, detail: string, room: string, thumb: image, has-thumb: bool, state: string, playback: bool }
export struct CameraRow { id: int, name: string, detail: string }
// A hub: `detail` is its model and firmware; `disk` names its main disk,
// `space` how full that is (`used` 0-1, or -1 when unknown), `health` its
// SMART temperature/uptime, and `note` the other disks or a problem; `loaded`
// once the hub has answered.
export struct HubRow {
    id: int,
    name: string,
    detail: string,
    storage: string,
    room: string,
    disk: string,
    space: string,
    health: string,
    used: float,
    warn: bool,
    note: string,
    loaded: bool,
    loop-known: bool,
    loop-on: bool,
    alarm-on: bool,
    busy: bool,
}
export struct PresetRow { id: string, name: string }
export struct RecRow {
    // A heading for the hour (`time`) rather than a recording or event.
    header: bool,
    time: string,
    camera: string,
    kind: string,
    // 1 person, 2 vehicle, 3 animal, 4 motion, 0 none
    icon: int,
    duration: string,
    playing: bool,
    saved: bool,
    thumb: image,
    has-thumb: bool,
}
export struct DayChip { day: string, has-video: bool, selected: bool, future: bool, in-month: bool }
export struct TlSeg { x: float, w: float, event: bool }
export struct TlTick { x: float, label: string }
export struct DownloadRow { label: string, status: string, path: string, done: bool }

// Everything the Rust side reads, writes or handles.
export global Bridge {
    // navigation & window chrome
    in-out property <Page> page: Page.home;
    in-out property <bool> fullscreen;
    in-out property <bool> custom-chrome: false;
    in-out property <bool> window-maximized: false;
    in-out property <bool> window-active: true;
    in-out property <bool> max-btn-hovered: false;
    in-out property <bool> max-btn-pressed: false;
    in property <string> status-text;
    callback navigate(Page);
    callback toggle-fullscreen();
    callback escape();
    callback window-minimize();
    callback window-toggle-maximize();
    callback window-close();

    // home
    in property <[HomeCard]> home-cameras;
    in property <string> account-name;
    // The Tapo app's home name, or "Home".
    in property <string> home-title: "Home";
    in property <string> home-subtitle;
    callback open-hub(int);
    callback hub-toggle-loop(int);
    callback hub-toggle-alarm(int);

    // live grid
    in property <[Tile]> tiles;
    in property <int> columns: 1;
    callback open-camera(int);
    callback toggle-tile-audio(int);
    // A camera's recordings on the hub, from its Home card.
    callback open-camera-playback(int);

    // single camera
    in property <string> single-name;
    in property <image> single-frame;
    in property <bool> single-has-frame;
    // The picture is the grid's or the last one, until the HD video comes.
    in property <bool> single-stale;
    in property <string> single-status;
    in-out property <int> single-quality;
    in property <[string]> quality-labels: ["SD", "HD"];
    callback quality-changed(int);
    callback snapshot();
    in property <bool> single-audio-on;
    callback single-toggle-audio();
    in property <bool> single-ptz;
    in property <bool> ptz-busy;
    in property <string> ptz-message;
    in property <[PresetRow]> presets;
    in-out property <int> ptz-step: 15;
    callback ptz-move(int, int);
    callback ptz-goto(string);
    callback ptz-save(string);
    callback ptz-delete(string);
    callback ptz-refresh();
    in-out property <bool> ptz-open;
    in property <bool> single-privacy;
    in property <bool> single-privacy-known;
    callback privacy-toggle();
    in property <bool> single-spotlight;
    in property <bool> single-spotlight-known;
    callback spotlight-toggle();
    in property <bool> single-nv-known;
    in-out property <int> single-nv-index;
    in property <[string]> nv-labels: ["Auto", "Day", "Infrared", "Color", "Smart"];
    callback night-vision-changed(int);
    in property <bool> single-track;
    in property <bool> single-track-known;
    callback auto-track-toggle();
    in property <bool> single-patrolling;
    callback patrol-start(int); // 0 horizontal, 1 vertical
    callback patrol-stop();
    in property <bool> single-siren;
    callback siren-toggle();
    in-out property <bool> reboot-confirm;
    callback camera-reboot();
    callback open-playback();
    callback single-back();

    // sign-in screens, shown while not signed in
    in-out property <int> onboarding-step; // 0 welcome, 1 log in, 2 verification code
    in-out property <string> login-email;
    in-out property <string> login-password;
    in-out property <bool> login-remember: true;
    in-out property <string> login-help;
    in property <bool> login-busy;
    in property <string> login-error;
    in property <string> mfa-sent-to;
    in property <int> mfa-method; // where the last code went: 1 = Tapo app, 2 = email
    in property <string> mfa-switch-label;
    in property <int> mfa-switch-method;
    in-out property <string> mfa-code;
    in property <[string]> mfa-digits: ["", "", "", "", "", ""];
    in property <int> mfa-filled;
    in-out property <int> mfa-resend-seconds;
    callback login();
    callback mfa-send(int);
    callback mfa-code-edited(string);
    callback mfa-verify();
    callback mfa-back();

    // settings: app
    in-out property <string> ffmpeg-path;
    in property <string> ffmpeg-found;
    in-out property <int> renderer-index;
    in-out property <int> theme-index; // 0 system, 1 light, 2 dark
    in property <string> config-path;
    callback save-settings();

    // settings: Tapo cloud sign-in
    in property <bool> cloud-signed-in;
    in property <bool> cloud-busy;
    in property <string> cloud-status;
    // The signed-in account, its first letter and its cloud server.
    in property <string> account-initial;
    in property <string> account-server;
    in property <string> cloud-message;
    // First entry is "Not linked"; the rest are the cameras on the account.
    in property <[string]> cloud-camera-labels: ["Not linked"];
    callback cloud-sign-out();
    callback cloud-refresh();

    // settings: cameras
    in property <[CameraRow]> cameras;
    in-out property <int> cam-editing: -1; // -1 closed, 0 new, otherwise camera id
    in-out property <string> cam-name;
    in-out property <int> cam-quality;
    in-out property <int> cam-cloud; // index into cloud-camera-labels
    in property <string> cam-error;
    callback new-camera();
    callback edit-camera(int);
    callback save-camera();
    callback delete-camera(int);
    callback move-camera(int, int);

    // playback: recordings on the hubs of the account
    in property <[HubRow]> hubs;
    in property <[string]> hub-names;
    in-out property <int> rec-hub;
    in property <bool> hub-busy;
    in property <bool> hub-connected;
    in property <string> hub-message;
    in property <[string]> paired-names;
    in-out property <int> rec-camera;
    in-out property <int> rec-filter;
    in property <[string]> rec-filter-labels: ["All", "Person", "Vehicle", "Pet", "Motion", "Alerts"];
    in property <string> rec-date;
    in property <string> rec-month;
    in property <bool> rec-month-is-current;
    in property <[DayChip]> rec-days;
    in property <string> rec-list-title;
    in property <bool> rec-loading;
    in property <string> rec-message;
    in property <[RecRow]> recordings;
    in property <[DownloadRow]> downloads;
    callback connect-hub();
    callback rec-hub-changed();
    callback rec-camera-changed();
    callback rec-filter-changed(int);
    callback change-month(int);
    callback go-today();
    callback pick-day(int);
    callback play-clip(int);
    callback download(int);
    // the player
    in property <bool> player-open;
    in property <image> player-frame;
    in property <bool> player-has-frame;
    in property <string> player-title;
    in property <string> player-status;
    in property <string> player-time;
    in property <bool> player-busy;
    in property <bool> player-paused;
    in property <bool> player-ended;
    in property <bool> player-audio-on;
    in property <[string]> speed-labels: ["1×"];
    in-out property <int> player-speed-index;
    callback player-stop();
    callback player-toggle-pause();
    callback player-toggle-audio();
    callback player-speed(int);
    callback player-snapshot();
    callback player-record();
    in property <bool> player-recording;
    in property <string> player-rec-time;
    // The list beside the player, hidden for a bigger picture.
    in-out property <bool> rec-side-hidden;
    // the timeline: positions are parts of its width
    in property <[TlSeg]> tl-segments;
    in property <[TlTick]> tl-ticks;
    in property <float> tl-playhead: -1;
    in property <bool> tl-zoomed;
    callback tl-click(float);
    callback tl-drag(float);
    callback tl-drag-end();
    // The time at a point of the timeline (a part of its width), as HH:MM:SS.
    pure callback tl-time-at(float) -> string;
    callback tl-zoom(float, float);
    callback tl-whole-day();
    callback open-file(string);
    // updates
    in property <string> app-version;
    in property <string> update-status;
    in property <bool> update-available;
    in property <string> update-version;
    in property <bool> update-busy;
    // The last update attempt failed; `update-status` says why.
    in property <bool> update-failed;
    in property <string> update-source;
    in-out property <bool> check-updates: true;
    in-out property <bool> update-dismissed;
    callback check-update();
    callback install-update();
    callback check-updates-changed();
    callback show-in-folder(string);
}

component Heading inherits Text {
    font-size: 15px;
    font-weight: 600;
}

component Muted inherits Text {
    color: Palette.foreground.transparentize(0.35);
    wrap: word-wrap;
}

component Field inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    VerticalLayout {
        alignment: center;
        Text { text: root.label; width: 130px; }
    }
    @children
}

// ------------------------------------------------------------ sign-in screens

component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <bool> busy;
    callback clicked();
    property <bool> active: root.enabled && !root.busy;
    property <color> base: !root.enabled ? Palette.foreground.transparentize(0.82)
        : root.primary ? Palette.accent-background : Palette.control-background;
    height: 48px;
    border-radius: self.height / 2;
    border-width: root.primary || !root.enabled ? 0px : 1px;
    border-color: Palette.border;
    background: touch.pressed && root.active ? root.base.darker(0.15)
        : touch.has-hover && root.active ? root.base.darker(0.07) : root.base;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if (root.active) { root.clicked(); } }
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        if root.busy: VerticalLayout {
            alignment: center;
            Spinner { width: 20px; height: 20px; indeterminate: true; }
        }
        Text {
            text: root.text;
            font-size: 16px;
            font-weight: 600;
            vertical-alignment: center;
            color: !root.enabled ? Palette.background : root.primary ? Palette.accent-foreground : Palette.accent-background;
        }
    }
    touch := TouchArea {
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component LinkText inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <TextHorizontalAlignment> align: left;
    in property <length> size: 14px;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    HorizontalLayout {
        Text {
            text: root.text;
            font-size: root.size;
            horizontal-alignment: root.align;
            color: !root.enabled ? Palette.foreground.transparentize(0.45)
                : touch.has-hover ? Palette.accent-background.darker(0.2) : Palette.accent-background;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// The app's mark: a camera lens on an accent tile.
component AppMark inherits Rectangle {
    in property <length> size: 96px;
    width: root.size;
    height: root.size;
    border-radius: root.size * 0.27;
    background: Palette.accent-background;
    drop-shadow-blur: root.size * 0.19;
    drop-shadow-offset-y: root.size * 0.06;
    drop-shadow-color: Palette.accent-background.transparentize(0.6);
    Rectangle {
        width: root.size * 0.52;
        height: self.width;
        border-radius: self.width / 2;
        background: Palette.accent-foreground;
        Rectangle {
            width: root.size * 0.29;
            height: self.width;
            border-radius: self.width / 2;
            background: Palette.accent-background.darker(0.25);
            Rectangle {
                x: parent.width * 0.21;
                y: parent.width * 0.21;
                width: root.size * 0.083;
                height: self.width;
                border-radius: self.width / 2;
                background: Palette.accent-foreground.transparentize(0.25);
            }
        }
    }
    Rectangle {
        x: parent.width - root.size * 0.27;
        y: root.size * 0.17;
        width: root.size * 0.083;
        height: self.width;
        border-radius: self.width / 2;
        background: Palette.accent-foreground.transparentize(0.3);
    }
}

// An eye that is crossed out while the password is hidden.
component EyeToggle inherits Rectangle {
    in-out property <bool> show;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: touch.has-hover ? Palette.control-background : transparent;
    accessible-role: button;
    accessible-label: root.show ? "Hide password" : "Show password";
    accessible-action-default => { root.show = !root.show; }
    Path {
        width: 22px;
        height: 22px;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: Palette.foreground.transparentize(0.3);
        stroke-width: 1.7px;
        fill: transparent;
        commands: root.show
            ? "M 1 12 C 4 6 8 4 12 4 C 16 4 20 6 23 12 C 20 18 16 20 12 20 C 8 20 4 18 1 12 Z M 12 8.5 A 3.5 3.5 0 1 0 12.01 8.5 Z"
            : "M 1 12 C 4 6 8 4 12 4 C 16 4 20 6 23 12 C 20 18 16 20 12 20 C 8 20 4 18 1 12 Z M 12 8.5 A 3.5 3.5 0 1 0 12.01 8.5 Z M 3 3 L 21 21";
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.show = !root.show; }
    }
}

// Six boxes over one invisible text field, so typing and pasting both work.
component CodeBoxes inherits Rectangle {
    in property <[string]> digits;
    in property <int> filled;
    in-out property <string> text;
    callback edited(string);
    callback accepted();
    height: 64px;
    HorizontalLayout {
        spacing: 10px;
        for d[i] in root.digits: Rectangle {
            property <bool> current: input.has-focus && (i == root.filled || (root.filled == 6 && i == 5));
            border-radius: 10px;
            border-width: self.current ? 2px : 1px;
            border-color: self.current ? Palette.accent-background : Palette.border;
            background: Palette.control-background;
            Text {
                text: d;
                font-size: 26px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    input := TextInput {
        width: 100%;
        height: 100%;
        color: transparent;
        selection-background-color: transparent;
        selection-foreground-color: transparent;
        single-line: true;
        input-type: number;
        accessible-label: "Verification code";
        text <=> root.text;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(); }
    }
    public function focus-input() {
        input.focus();
    }
}

component SignInCard inherits Rectangle {
    width: min(440px, (root.parent-width) - 32px);
    in property <length> parent-width;
    border-radius: 20px;
    background: Palette.background;
    drop-shadow-blur: 30px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000055;
    @children
}

component ErrorText inherits Text {
    color: #e5484d;
    wrap: word-wrap;
    font-size: 13px;
}

component LogInCard inherits SignInCard {
    property <bool> show-password;
    init => {
        if (Bridge.login-email == "") { email.focus(); } else { password.focus(); }
    }
    VerticalLayout {
        padding: 28px;
        padding-top: 14px;
        spacing: 14px;
        HorizontalLayout {
            alignment: start;
            LinkText {
                text: "✕";
                size: 20px;
                enabled: !Bridge.login-busy;
                clicked => {
                    Bridge.login-help = "";
                    Bridge.onboarding-step = 0;
                }
            }
        }
        Text { text: "Log in"; font-size: 26px; font-weight: 700; }
        Muted { text: "Use your TP-Link ID: the email and password you use in the Tapo app."; }
        email := LineEdit {
            height: 44px;
            placeholder-text: "TP-Link ID (email)";
            text <=> Bridge.login-email;
            enabled: !Bridge.login-busy;
            accepted => { password.focus(); }
        }
        HorizontalLayout {
            spacing: 6px;
            password := LineEdit {
                height: 44px;
                horizontal-stretch: 1;
                placeholder-text: "Password";
                input-type: root.show-password ? InputType.text : InputType.password;
                text <=> Bridge.login-password;
                enabled: !Bridge.login-busy;
                accepted => {
                    if (Bridge.login-email != "" && Bridge.login-password != "") { Bridge.login(); }
                }
            }
            VerticalLayout {
                alignment: center;
                EyeToggle { show <=> root.show-password; }
            }
        }
        CheckBox {
            text: "Remember me";
            checked <=> Bridge.login-remember;
            enabled: !Bridge.login-busy;
        }
        if Bridge.login-help != "": Rectangle {
            border-radius: 10px;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 12px;
                Muted { text: Bridge.login-help; }
            }
        }
        if Bridge.login-error != "": ErrorText { text: Bridge.login-error; }
        Rectangle { height: 6px; }
        PillButton {
            text: Bridge.login-busy ? "Logging in…" : "Log In";
            primary: true;
            enabled: Bridge.login-email != "" && Bridge.login-password != "";
            busy: Bridge.login-busy;
            clicked => { Bridge.login(); }
        }
        HorizontalLayout {
            LinkText {
                text: "Sign Up";
                clicked => {
                    Bridge.login-help = "TP-Link IDs are created in the Tapo app: open it on your phone, tap “Create a TP-Link ID” and follow the steps. Then log in here with the same email and password.";
                }
            }
            Rectangle { horizontal-stretch: 1; }
            LinkText {
                text: "Forgot Password?";
                align: right;
                clicked => {
                    Bridge.login-help = "Reset your password in the Tapo app: on its login screen, tap “Forgot Password?”. Then log in here with the new password.";
                }
            }
        }
    }
}

component VerificationCard inherits SignInCard {
    init => { boxes.focus-input(); }
    Timer {
        interval: 1s;
        running: Bridge.mfa-resend-seconds > 0;
        triggered => { Bridge.mfa-resend-seconds -= 1; }
    }
    VerticalLayout {
        padding: 28px;
        padding-top: 14px;
        spacing: 14px;
        HorizontalLayout {
            back := LinkText {
                width: 32px;
                text: "‹";
                size: 30px;
                enabled: !Bridge.login-busy;
                clicked => { Bridge.mfa-back(); }
            }
            Text {
                text: "Two-Step Verification";
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Rectangle { width: back.width; }
        }
        Muted { text: Bridge.mfa-sent-to; }
        boxes := CodeBoxes {
            digits: Bridge.mfa-digits;
            filled: Bridge.mfa-filled;
            text <=> Bridge.mfa-code;
            edited(text) => { Bridge.mfa-code-edited(text); }
            accepted => { if (Bridge.mfa-filled == 6) { Bridge.mfa-verify(); } }
        }
        LinkText {
            text: Bridge.mfa-resend-seconds > 0 ? "Resend Code (" + Bridge.mfa-resend-seconds + "s)" : "Resend Code";
            enabled: Bridge.mfa-resend-seconds == 0 && !Bridge.login-busy;
            clicked => { Bridge.mfa-send(Bridge.mfa-method); }
        }
        if Bridge.login-error != "": ErrorText { text: Bridge.login-error; }
        Rectangle { height: 40px; }
        if Bridge.mfa-switch-label != "": LinkText {
            text: Bridge.mfa-switch-label;
            align: center;
            enabled: !Bridge.login-busy;
            clicked => { Bridge.mfa-send(Bridge.mfa-switch-method); }
        }
        PillButton {
            text: "Verify";
            primary: true;
            enabled: Bridge.mfa-filled == 6;
            busy: Bridge.login-busy;
            clicked => { Bridge.mfa-verify(); }
        }
    }
}

// Shown while not signed in: welcome, then log in, then the code if Tapo asks.
component SignInScreens inherits Rectangle {
    background: @linear-gradient(160deg, Palette.background 0%, Palette.alternate-background 100%);
    VerticalLayout {
        alignment: center;
        spacing: 0px;
        padding: 24px;
        HorizontalLayout {
            alignment: center;
            AppMark { }
        }
        Rectangle { height: 24px; }
        Text {
            text: "Tapas";
            font-size: 44px;
            font-weight: 700;
            color: Palette.accent-background;
            horizontal-alignment: center;
        }
        Rectangle { height: 8px; }
        Text {
            text: "Your Tapo cameras on your desktop, from anywhere.";
            font-size: 18px;
            color: Palette.foreground.transparentize(0.25);
            horizontal-alignment: center;
        }
        Rectangle { height: 96px; }
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(380px, root.width - 48px);
                spacing: 14px;
                PillButton {
                    text: "Log In";
                    primary: true;
                    clicked => {
                        Bridge.login-help = "";
                        Bridge.onboarding-step = 1;
                    }
                }
                PillButton {
                    text: "Create a TP-Link ID";
                    clicked => {
                        Bridge.login-help = "TP-Link IDs are created in the Tapo app: open it on your phone, tap “Create a TP-Link ID” and follow the steps. Then log in here with the same email and password.";
                        Bridge.onboarding-step = 1;
                    }
                }
                if Bridge.login-error != "" && Bridge.onboarding-step == 0: ErrorText {
                    text: Bridge.login-error;
                    horizontal-alignment: center;
                }
            }
        }
    }
    if Bridge.onboarding-step > 0: Rectangle {
        background: #00000070;
        // Clicks on the dimmed area don't reach the welcome buttons.
        TouchArea { }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                if Bridge.onboarding-step == 1: LogInCard { parent-width: root.width; }
                if Bridge.onboarding-step == 2: VerificationCard { parent-width: root.width; }
            }
        }
    }
}

// Outline icons on a 24×24 grid, drawn with `Icon`.
global Icons {
    out property <string> home: "M 3 10.5 L 12 3 L 21 10.5 M 5.5 8.6 V 20 H 10 V 14.5 H 14 V 20 H 18.5 V 8.6";
    out property <string> grid: "M 4 4 H 10.5 V 10.5 H 4 Z M 13.5 4 H 20 V 10.5 H 13.5 Z M 4 13.5 H 10.5 V 20 H 4 Z M 13.5 13.5 H 20 V 20 H 13.5 Z";
