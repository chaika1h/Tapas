import { AboutSlint, Button, LineEdit, ComboBox, CheckBox, Slider, ScrollView, GroupBox, Spinner, Palette, ListView, Switch } from "std-widgets.slint";

export enum Page { home, live, single, recordings, people, settings }

export struct Tile {
    id: int,
    name: string,
    frame: image,
    has-frame: bool,
    status: string,
    live: bool,
    // The frame is the camera's last picture, shown until live video comes.
    stale: bool,
    audio-on: bool,
}

// A camera on Home: `detail` is its model, `room` its room in the Tapo
// app; `playback` when a hub records it.
export struct HomeCard { id: int, name: string, detail: string, room: string, thumb: image, has-thumb: bool, state: string, playback: bool }
export struct CameraRow { id: int, name: string, detail: string }
// A hub: `detail` is its model and firmware; `disk` names its main disk,
// `space` how full that is (`used` 0-1, or -1 when unknown), `health` its
// SMART temperature/uptime, and `note` the other disks or a problem; `loaded`
// once the hub has answered.
export struct HubRow {
    id: int,
    name: string,
    detail: string,
    storage: string,
    room: string,
    disk: string,
    space: string,
    health: string,
    used: float,
    warn: bool,
    note: string,
    loaded: bool,
    loop-known: bool,
    loop-on: bool,
    alarm-on: bool,
    busy: bool,
}
export struct PresetRow { id: string, name: string }
export struct RecRow {
    // A heading for the hour (`time`) rather than a recording or event.
    header: bool,
    time: string,
    camera: string,
    kind: string,
    // 1 person, 2 vehicle, 3 animal, 4 motion, 0 none
    icon: int,
    duration: string,
    playing: bool,
    saved: bool,
    selected: bool,
    thumb: image,
    has-thumb: bool,
}
export struct HourBar { hour: int, count: int, ratio: float, peak: bool }
export struct FaceRow {
    face-id: string,
    name: string,
    initial: string,
    familiar: bool,
    last-seen: string,
    selected: bool,
    photo: image,
    has-photo: bool,
}
export struct FaceTrackRow {
    time: string,
    camera: string,
    clips: string,
    face-name: string,
    familiar: bool,
    playable: bool,
    photo: image,
    has-photo: bool,
}
export struct DayChip { day: string, has-video: bool, selected: bool, future: bool, in-month: bool }
export struct TlSeg { x: float, w: float, event: bool }
export struct TlTick { x: float, label: string }
export struct DownloadRow { label: string, status: string, path: string, done: bool }

// Everything the Rust side reads, writes or handles.
export global Bridge {
    // navigation & window chrome
    in-out property <Page> page: Page.home;
    in-out property <bool> fullscreen;
    in-out property <bool> custom-chrome: false;
    in-out property <bool> window-maximized: false;
    in-out property <bool> window-active: true;
    in-out property <bool> max-btn-hovered: false;
    in-out property <bool> max-btn-pressed: false;
    in property <string> status-text;
    in property <string> status-action-path;
    callback clear-status();
    // hover tooltip rendered above all clipped containers
    in-out property <string> tip-text;
    in-out property <length> tip-x;
    in-out property <length> tip-y;
    callback navigate(Page);
    callback toggle-fullscreen();
    callback escape();
    callback window-minimize();
    callback window-toggle-maximize();
    callback window-close();

    // home
    in property <[HomeCard]> home-cameras;
    in property <string> account-name;
    // The Tapo app's home name, or "Home".
    in property <string> home-title: "Home";
    in property <string> home-subtitle;
    callback open-hub(int);
    callback hub-toggle-loop(int);
    callback hub-toggle-alarm(int);

    // live grid
    in property <[Tile]> tiles;
    in property <int> columns: 1;
    callback open-camera(int);
    callback toggle-tile-audio(int);
    // A camera's recordings on the hub, from its Home card.
    callback open-camera-playback(int);

    // single camera
    in property <string> single-name;
    in property <bool> single-can-switch;
    callback single-step-camera(int);
    in property <image> single-frame;
    in property <bool> single-has-frame;
    // The picture is the grid's or the last one, until the HD video comes.
    in property <bool> single-stale;
    in property <string> single-status;
    in-out property <int> single-quality;
    in property <[string]> quality-labels: ["SD", "HD"];
    callback quality-changed(int);
    callback snapshot();
    in property <bool> single-recording;
    in property <string> single-rec-time;
    callback single-record();
    in property <bool> single-audio-on;
    callback single-toggle-audio();
    // digital zoom & pan (shared between Single live view and Playback player)
    in-out property <float> video-zoom: 1.0;
    in-out property <float> video-pan-x: 0.0;
    in-out property <float> video-pan-y: 0.0;
    callback reset-zoom();
    // NVR keyboard shortcut helpers
    callback player-skip(int);
    callback player-step-speed(int);
    callback open-camera-slot(int);
    in property <bool> single-ptz;
    in property <bool> ptz-busy;
    in property <string> ptz-message;
    in property <[PresetRow]> presets;
    in-out property <int> ptz-step: 15;
    callback ptz-move(int, int);
    callback ptz-goto(string);
    callback ptz-save(string);
    callback ptz-delete(string);
    callback ptz-refresh();
    in-out property <bool> ptz-open;
    in property <bool> single-privacy;
    in property <bool> single-privacy-known;
    callback privacy-toggle();
    in property <bool> single-spotlight;
    in property <bool> single-spotlight-known;
    callback spotlight-toggle();
    in property <bool> single-nv-known;
    in-out property <int> single-nv-index;
    in property <[string]> nv-labels: ["Auto", "Day", "Infrared", "Color", "Smart"];
    callback night-vision-changed(int);
    in property <bool> single-track;
    in property <bool> single-track-known;
    callback auto-track-toggle();
    in property <bool> single-patrolling;
    callback patrol-start(int); // 0 horizontal, 1 vertical
    callback patrol-stop();
    in property <bool> single-siren;
    callback siren-toggle();
    in-out property <bool> reboot-confirm;
    callback camera-reboot();
    callback open-playback();
    callback single-back();

    // sign-in screens, shown while not signed in
    in-out property <int> onboarding-step; // 0 welcome, 1 log in, 2 verification code
    in-out property <string> login-email;
    in-out property <string> login-password;
    in-out property <bool> login-remember: true;
    in-out property <string> login-help;
    in property <bool> login-busy;
    in property <string> login-error;
    in property <string> mfa-sent-to;
    in property <int> mfa-method; // where the last code went: 1 = Tapo app, 2 = email
    in property <string> mfa-switch-label;
    in property <int> mfa-switch-method;
    in-out property <string> mfa-code;
    in property <[string]> mfa-digits: ["", "", "", "", "", ""];
    in property <int> mfa-filled;
    in-out property <int> mfa-resend-seconds;
    callback login();
    callback mfa-send(int);
    callback mfa-code-edited(string);
    callback mfa-verify();
    callback mfa-back();

    // settings: app
    in-out property <int> renderer-index;
    in-out property <int> theme-index; // 0 system, 1 light, 2 dark
    in-out property <int> language-index; // 0 system, 1 English, 2 Turkish
    in property <string> config-path;
    callback save-settings();

    // settings: Tapo cloud sign-in
    in property <bool> cloud-signed-in;
    in property <bool> cloud-busy;
    in property <string> cloud-status;
    // The signed-in account, its first letter and its cloud server.
    in property <string> account-initial;
    in property <string> account-server;
    in property <string> cloud-message;
    // First entry is "Not linked"; the rest are the cameras on the account.
    in property <[string]> cloud-camera-labels: ["Not linked"];
    callback cloud-sign-out();
    callback cloud-refresh();

    // settings: cameras
    in property <[CameraRow]> cameras;
    in-out property <int> cam-editing: -1; // -1 closed, 0 new, otherwise camera id
    in-out property <string> cam-name;
    in-out property <int> cam-quality;
    in-out property <int> cam-cloud; // index into cloud-camera-labels
    in property <string> cam-error;
    callback new-camera();
    callback edit-camera(int);
    callback save-camera();
    callback delete-camera(int);
    callback move-camera(int, int);

    // playback: recordings on the hubs of the account
    in property <[HubRow]> hubs;
    in property <[string]> hub-names;
    in-out property <int> rec-hub;
    in property <bool> hub-busy;
    in property <bool> hub-connected;
    in property <string> hub-message;
    in property <[string]> paired-names;
    in-out property <int> rec-camera;
    in-out property <int> rec-filter;
    in property <[string]> rec-filter-labels: ["All", "Person", "Vehicle", "Pet", "Motion", "Alerts"];
    in property <string> rec-date;
    in property <string> rec-month;
    in property <bool> rec-month-is-current;
    in property <[DayChip]> rec-days;
    in property <string> rec-list-title;
    in property <bool> rec-loading;
    in property <string> rec-message;
    in property <[RecRow]> recordings;
    in property <[DownloadRow]> downloads;
    callback connect-hub();
    callback rec-hub-changed();
    callback rec-camera-changed();
    callback rec-filter-changed(int);
    callback change-month(int);
    callback go-today();
    callback pick-day(int);
    callback play-clip(int);
    callback download(int);
    // the player
    in property <bool> player-open;
    in property <image> player-frame;
    in property <bool> player-has-frame;
    in property <string> player-title;
    in property <string> player-status;
    in property <string> player-time;
    in property <bool> player-busy;
    in property <bool> player-paused;
    in property <bool> player-ended;
    in property <bool> player-audio-on;
    in property <[string]> speed-labels: ["1×"];
    in-out property <int> player-speed-index;
    callback player-stop();
    callback player-toggle-pause();
    callback player-toggle-audio();
    callback player-speed(int);
    callback player-snapshot();
    callback player-record();
    in property <bool> player-recording;
    in property <string> player-rec-time;
    // The list beside the player, hidden for a bigger picture.
    in-out property <bool> rec-side-hidden;
    // the timeline: positions are parts of its width
    in property <[TlSeg]> tl-segments;
    in property <[TlTick]> tl-ticks;
    in property <float> tl-playhead: -1;
    in property <bool> tl-zoomed;
    callback tl-click(float);
    callback tl-drag(float);
    callback tl-drag-end();
    // The time at a point of the timeline (a part of its width), as HH:MM:SS.
    pure callback tl-time-at(float) -> string;
    callback tl-zoom(float, float);
    callback tl-whole-day();
    callback open-file(string);
    // 24-hour activity summary chart
    in property <[HourBar]> hour-bars;
    in property <string> hour-summary;
    callback jump-hour(int);
    // batch MP4 clip export
    in-out property <bool> batch-mode;
    in property <int> batch-selected-count;
    in property <bool> batch-busy;
    in property <string> batch-status;
    callback batch-toggle-mode();
    callback batch-toggle-row(int);
    callback batch-select-all();
    callback batch-clear();
    callback batch-export();
    callback batch-cancel();
    // people / H500 facial recognition & cross-camera tracking
    in property <[FaceRow]> faces;
    in-out property <string> face-search;
    in-out property <int> face-filter;
    in property <[string]> face-filter-labels: ["All", "Familiar", "Stranger"];
    in property <bool> faces-loading;
    in property <string> faces-message;
    in property <string> selected-face-id;
    in property <string> selected-face-title;
    in-out property <string> face-edit-name;
    in-out property <bool> face-edit-familiar;
    in property <bool> face-saving;
    in property <string> face-track-date;
    in property <bool> face-track-is-today;
    in property <bool> face-track-loading;
    in property <string> face-track-message;
    in property <[FaceTrackRow]> face-tracks;
    callback faces-refresh();
    callback face-search-changed(string);
    callback face-filter-changed(int);
    callback face-select(string);
    callback face-save();
    callback face-track-day(int);
    callback face-track-play(int);
    // updates
    in property <string> app-version;
    in property <string> update-status;
    in property <bool> update-available;
    in property <string> update-version;
    in property <bool> update-busy;
    // The last update attempt failed; `update-status` says why.
    in property <bool> update-failed;
    in-out property <bool> check-updates: true;
    in-out property <bool> update-dismissed;
    callback check-update();
    callback install-update();
    callback check-updates-changed();
    callback show-in-folder(string);
}

