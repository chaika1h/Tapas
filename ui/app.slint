    in-out property <string> sc-rec: "Start or stop MP4 recording (Videos\\Tapas)";
    in-out property <string> sc-zoom: "Scroll to zoom (1×–8×), drag to pan; press 0 to reset";
    in-out property <string> sc-full: "Toggle or leave fullscreen, or go back from Single view";
    in-out property <string> sec-about: "About and updates";
    in-out property <string> about-default: "TP-Link Tapo cameras and the H500 HomeBase, through the Tapo cloud.";
    in-out property <string> update-to-prefix: "Update to ";
    in-out property <string> check-updates: "Check for updates";
    in-out property <string> auto-update-title: "Check for updates at start-up";
    in-out property <string> auto-update-desc: "When a new version is available, it installs automatically and Tapas restarts.";
    in-out property <string> credits-note: "Uses FFmpeg (LGPL) and open-source Tapo protocol libraries (MIT).";
    in-out property <[string]> appearance-labels: ["Same as Windows", "Light", "Dark"];
    in-out property <[string]> language-labels: ["System (Auto)", "English", "Türkçe"];
    in-out property <[string]> renderer-labels: ["OpenGL (recommended)", "Software (CPU)"];
}

component Heading inherits Text {
    font-size: 15px;
    font-weight: 600;
}

component Muted inherits Text {
    color: Palette.foreground.transparentize(0.35);
    wrap: word-wrap;
}

component Field inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    VerticalLayout {
        alignment: center;
        Text { text: root.label; width: 130px; }
    }
    @children
}

// ------------------------------------------------------------ sign-in screens

component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <bool> busy;
    callback clicked();
    property <bool> active: root.enabled && !root.busy;
    property <color> base: !root.enabled ? Palette.foreground.transparentize(0.82)
        : root.primary ? Palette.accent-background : Palette.control-background;
    height: 48px;
    border-radius: self.height / 2;
    border-width: root.primary || !root.enabled ? 0px : 1px;
    border-color: Palette.border;
    background: touch.pressed && root.active ? root.base.darker(0.15)
        : touch.has-hover && root.active ? root.base.darker(0.07) : root.base;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if (root.active) { root.clicked(); } }
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        if root.busy: VerticalLayout {
            alignment: center;
            Spinner { width: 20px; height: 20px; indeterminate: true; }
        }
        Text {
            text: root.text;
            font-size: 16px;
            font-weight: 600;
            vertical-alignment: center;
            color: !root.enabled ? Palette.background : root.primary ? Palette.accent-foreground : Palette.accent-background;
        }
    }
    touch := TouchArea {
        enabled: root.active;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component LinkText inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <TextHorizontalAlignment> align: left;
    in property <length> size: 14px;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    HorizontalLayout {
        Text {
            text: root.text;
            font-size: root.size;
            horizontal-alignment: root.align;
            color: !root.enabled ? Palette.foreground.transparentize(0.45)
                : touch.has-hover ? Palette.accent-background.darker(0.2) : Palette.accent-background;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// The app's mark: a camera lens on an accent tile.
component AppMark inherits Rectangle {
    in property <length> size: 96px;
    width: root.size;
    height: root.size;
    border-radius: root.size * 0.27;
    background: Palette.accent-background;
    drop-shadow-blur: root.size * 0.19;
    drop-shadow-offset-y: root.size * 0.06;
    drop-shadow-color: Palette.accent-background.transparentize(0.6);
    Rectangle {
        width: root.size * 0.52;
        height: self.width;
        border-radius: self.width / 2;
        background: Palette.accent-foreground;
        Rectangle {
            width: root.size * 0.29;
            height: self.width;
            border-radius: self.width / 2;
            background: Palette.accent-background.darker(0.25);
            Rectangle {
                x: parent.width * 0.21;
                y: parent.width * 0.21;
                width: root.size * 0.083;
                height: self.width;
                border-radius: self.width / 2;
                background: Palette.accent-foreground.transparentize(0.25);
            }
        }
    }
    Rectangle {
        x: parent.width - root.size * 0.27;
        y: root.size * 0.17;
        width: root.size * 0.083;
        height: self.width;
        border-radius: self.width / 2;
        background: Palette.accent-foreground.transparentize(0.3);
    }
}

// An eye that is crossed out while the password is hidden.
component EyeToggle inherits Rectangle {
    in-out property <bool> show;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: touch.has-hover ? Palette.control-background : transparent;
    accessible-role: button;
    accessible-label: root.show ? Tr.hide-password : Tr.show-password;
    accessible-action-default => { root.show = !root.show; }
    Path {
        width: 22px;
        height: 22px;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: Palette.foreground.transparentize(0.3);
        stroke-width: 1.7px;
        fill: transparent;
        commands: root.show
            ? "M 1 12 C 4 6 8 4 12 4 C 16 4 20 6 23 12 C 20 18 16 20 12 20 C 8 20 4 18 1 12 Z M 12 8.5 A 3.5 3.5 0 1 0 12.01 8.5 Z"
            : "M 1 12 C 4 6 8 4 12 4 C 16 4 20 6 23 12 C 20 18 16 20 12 20 C 8 20 4 18 1 12 Z M 12 8.5 A 3.5 3.5 0 1 0 12.01 8.5 Z M 3 3 L 21 21";
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.show = !root.show; }
    }
}

// Six boxes over one invisible text field, so typing and pasting both work.
component CodeBoxes inherits Rectangle {
    in property <[string]> digits;
    in property <int> filled;
    in-out property <string> text;
    callback edited(string);
    callback accepted();
    height: 64px;
    HorizontalLayout {
        spacing: 10px;
        for d[i] in root.digits: Rectangle {
            property <bool> current: input.has-focus && (i == root.filled || (root.filled == 6 && i == 5));
            border-radius: 10px;
            border-width: self.current ? 2px : 1px;
            border-color: self.current ? Palette.accent-background : Palette.border;
            background: Palette.control-background;
            Text {
                text: d;
                font-size: 26px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
    input := TextInput {
        width: 100%;
        height: 100%;
        color: transparent;
        selection-background-color: transparent;
        selection-foreground-color: transparent;
        single-line: true;
        input-type: number;
        accessible-label: "Verification code";
        text <=> root.text;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(); }
    }
    public function focus-input() {
        input.focus();
    }
}

component SignInCard inherits Rectangle {
    width: min(440px, (root.parent-width) - 32px);
    in property <length> parent-width;
    border-radius: 20px;
    background: Palette.background;
    drop-shadow-blur: 30px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000055;
    @children
}

component ErrorText inherits Text {
    color: #e5484d;
    wrap: word-wrap;
    font-size: 13px;
}

component LogInCard inherits SignInCard {
    property <bool> show-password;
    init => {
        if (Bridge.login-email == "") { email.focus(); } else { password.focus(); }
    }
    VerticalLayout {
        padding: 28px;
        padding-top: 14px;
        spacing: 14px;
        HorizontalLayout {
            alignment: start;
            LinkText {
                text: "✕";
                size: 20px;
                enabled: !Bridge.login-busy;
                clicked => {
                    Bridge.login-help = "";
                    Bridge.onboarding-step = 0;
                }
            }
        }
        Text { text: Tr.log-in; font-size: 26px; font-weight: 700; }
        Muted { text: Tr.login-subtitle; }
        email := LineEdit {
            height: 44px;
            placeholder-text: Tr.email-placeholder;
            text <=> Bridge.login-email;
            enabled: !Bridge.login-busy;
            accepted => { password.focus(); }
        }
        HorizontalLayout {
            spacing: 6px;
            password := LineEdit {
                height: 44px;
                horizontal-stretch: 1;
                placeholder-text: Tr.password-placeholder;
                input-type: root.show-password ? InputType.text : InputType.password;
                text <=> Bridge.login-password;
                enabled: !Bridge.login-busy;
                accepted => {
                    if (Bridge.login-email != "" && Bridge.login-password != "") { Bridge.login(); }
                }
            }
            VerticalLayout {
                alignment: center;
                EyeToggle { show <=> root.show-password; }
            }
        }
        CheckBox {
            text: Tr.remember-me;
            checked <=> Bridge.login-remember;
            enabled: !Bridge.login-busy;
        }
        if Bridge.login-help != "": Rectangle {
            border-radius: 10px;
            background: Palette.alternate-background;
            VerticalLayout {
                padding: 12px;
                Muted { text: Bridge.login-help; }
            }
        }
        if Bridge.login-error != "": ErrorText { text: Bridge.login-error; }
        Rectangle { height: 6px; }
        PillButton {
            text: Bridge.login-busy ? Tr.logging-in : Tr.log-in;
            primary: true;
            enabled: Bridge.login-email != "" && Bridge.login-password != "";
            busy: Bridge.login-busy;
            clicked => { Bridge.login(); }
        }
        HorizontalLayout {
            LinkText {
                text: Tr.sign-up;
                clicked => {
                    Bridge.login-help = Tr.sign-up-help;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            LinkText {
                text: Tr.forgot-password;
                align: right;
                clicked => {
                    Bridge.login-help = Tr.forgot-help;
                }
            }
        }
    }
}

component VerificationCard inherits SignInCard {
    init => { boxes.focus-input(); }
    Timer {
        interval: 1s;
        running: Bridge.mfa-resend-seconds > 0;
        triggered => { Bridge.mfa-resend-seconds -= 1; }
    }
    VerticalLayout {
        padding: 28px;
        padding-top: 14px;
        spacing: 14px;
        HorizontalLayout {
            back := LinkText {
                width: 32px;
                text: "‹";
                size: 30px;
                enabled: !Bridge.login-busy;
                clicked => { Bridge.mfa-back(); }
            }
            Text {
                text: Tr.mfa-title;
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Rectangle { width: back.width; }
        }
        Muted { text: Bridge.mfa-sent-to; }
        boxes := CodeBoxes {
            digits: Bridge.mfa-digits;
            filled: Bridge.mfa-filled;
            text <=> Bridge.mfa-code;
            edited(text) => { Bridge.mfa-code-edited(text); }
            accepted => { if (Bridge.mfa-filled == 6) { Bridge.mfa-verify(); } }
        }
        LinkText {
            text: Bridge.mfa-resend-seconds > 0 ? Tr.mfa-resend + " (" + Bridge.mfa-resend-seconds + "s)" : Tr.mfa-resend;
            enabled: Bridge.mfa-resend-seconds == 0 && !Bridge.login-busy;
            clicked => { Bridge.mfa-send(Bridge.mfa-method); }
        }
        if Bridge.login-error != "": ErrorText { text: Bridge.login-error; }
        Rectangle { height: 40px; }
        if Bridge.mfa-switch-label != "": LinkText {
            text: Bridge.mfa-switch-label;
            align: center;
            enabled: !Bridge.login-busy;
            clicked => { Bridge.mfa-send(Bridge.mfa-switch-method); }
        }
        PillButton {
            text: Tr.mfa-verify;
            primary: true;
            enabled: Bridge.mfa-filled == 6;
            busy: Bridge.login-busy;
            clicked => { Bridge.mfa-verify(); }
        }
    }
}

// Shown while not signed in: welcome, then log in, then the code if Tapo asks.
component SignInScreens inherits Rectangle {
    background: @linear-gradient(160deg, Palette.background 0%, Palette.alternate-background 100%);
    VerticalLayout {
        alignment: center;
        spacing: 0px;
        padding: 24px;
        HorizontalLayout {
            alignment: center;
            AppMark { }
        }
        Rectangle { height: 24px; }
        Text {
            text: "Tapas";
            font-size: 44px;
            font-weight: 700;
            color: Palette.accent-background;
            horizontal-alignment: center;
        }
        Rectangle { height: 8px; }
        Text {
            text: Tr.welcome-tagline;
            font-size: 18px;
            color: Palette.foreground.transparentize(0.25);
            horizontal-alignment: center;
        }
        Rectangle { height: 96px; }
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(380px, root.width - 48px);
                spacing: 14px;
                PillButton {
                    text: Tr.log-in;
                    primary: true;
                    clicked => {
                        Bridge.login-help = "";
                        Bridge.onboarding-step = 1;
                    }
                }
                PillButton {
                    text: Tr.create-id;
                    clicked => {
                        Bridge.login-help = Tr.sign-up-help;
                        Bridge.onboarding-step = 1;
                    }
                }
                if Bridge.login-error != "" && Bridge.onboarding-step == 0: ErrorText {
                    text: Bridge.login-error;
                    horizontal-alignment: center;
                }
            }
        }
    }
    if Bridge.onboarding-step > 0: Rectangle {
        background: #00000070;
        // Clicks on the dimmed area don't reach the welcome buttons.
        TouchArea { }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                if Bridge.onboarding-step == 1: LogInCard { parent-width: root.width; }
                if Bridge.onboarding-step == 2: VerificationCard { parent-width: root.width; }
            }
        }
    }
}

// Outline icons on a 24×24 grid, drawn with `Icon`.
global Icons {
    out property <string> home: "M 3 10.5 L 12 3 L 21 10.5 M 5.5 8.6 V 20 H 10 V 14.5 H 14 V 20 H 18.5 V 8.6";
    out property <string> grid: "M 4 4 H 10.5 V 10.5 H 4 Z M 13.5 4 H 20 V 10.5 H 13.5 Z M 4 13.5 H 10.5 V 20 H 4 Z M 13.5 13.5 H 20 V 20 H 13.5 Z";
    out property <string> playback: "M 4.6 8 A 8.5 8.5 0 1 1 3.5 12 M 4.6 3.6 V 8 H 9 M 12 7.5 V 12 L 15 14";
    out property <string> settings: "M 12 5 A 7 7 0 1 0 12.01 5 Z M 12 9.2 A 2.8 2.8 0 1 0 12.01 9.2 Z M 19 12 H 21.5 M 16.95 16.95 L 18.7 18.7 M 12 19 V 21.5 M 7.05 16.95 L 5.3 18.7 M 5 12 H 2.5 M 7.05 7.05 L 5.3 5.3 M 12 5 V 2.5 M 16.95 7.05 L 18.7 5.3";
    out property <string> video: "M 3 7 H 15 V 17 H 3 Z M 15 10.5 L 21 7.5 V 16.5 L 15 13.5";
    out property <string> photo: "M 3 8.5 H 7.5 L 9.5 5.5 H 14.5 L 16.5 8.5 H 21 V 19 H 3 Z M 12 10 A 3.5 3.5 0 1 0 12.01 10 Z";
    out property <string> move: "M 12 2.5 V 9 M 9 5.5 L 12 2.5 L 15 5.5 M 12 21.5 V 15 M 9 18.5 L 12 21.5 L 15 18.5 M 2.5 12 H 9 M 5.5 9 L 2.5 12 L 5.5 15 M 21.5 12 H 15 M 18.5 9 L 21.5 12 L 18.5 15";
    out property <string> privacy: "M 2 12 C 5 6.5 8.5 5 12 5 C 15.5 5 19 6.5 22 12 C 19 17.5 15.5 19 12 19 C 8.5 19 5 17.5 2 12 Z M 12 9 A 3 3 0 1 0 12.01 9 Z M 4 4 L 20 20";
    out property <string> fullscreen: "M 4 9 V 4 H 9 M 15 4 H 20 V 9 M 20 15 V 20 H 15 M 9 20 H 4 V 15";
    out property <string> exit-fullscreen: "M 9 4 V 9 H 4 M 20 9 H 15 V 4 M 15 20 V 15 H 20 M 4 15 H 9 V 20";
    out property <string> back: "M 15 4.5 L 7.5 12 L 15 19.5";
    out property <string> chevron-right: "M 9 4.5 L 16.5 12 L 9 19.5";
    out property <string> chevron-up: "M 4.5 15.5 L 12 8 L 19.5 15.5";
    out property <string> chevron-down: "M 4.5 8.5 L 12 16 L 19.5 8.5";
    out property <string> chevron-left: "M 15.5 4.5 L 8 12 L 15.5 19.5";
    out property <string> hub: "M 3.5 8.5 H 20.5 V 17.5 H 3.5 Z M 6.5 13 H 11 M 16 13 H 17.5 M 6 6 H 18";
    out property <string> refresh: "M 19.5 12 A 7.5 7.5 0 1 1 17.3 6.7 M 19.5 3.5 V 7.5 H 15.5";
    out property <string> play: "M 8 5.5 L 18.5 12 L 8 18.5 Z";
    out property <string> download: "M 12 4 V 15 M 7.5 10.5 L 12 15 L 16.5 10.5 M 5 19.5 H 19";
    out property <string> folder: "M 3.5 6.5 H 9.5 L 11.5 8.5 H 20.5 V 18.5 H 3.5 Z";
    out property <string> stop: "M 6.5 6.5 H 17.5 V 17.5 H 6.5 Z";
    out property <string> check: "M 5 12.5 L 10 17 L 19 7.5";
    out property <string> pause: "M 8.5 5.5 V 18.5 M 15.5 5.5 V 18.5";
    out property <string> record: "M 3 7 H 15 V 17 H 3 Z M 15 10.5 L 21 7.5 V 16.5 L 15 13.5 M 9 10 A 2 2 0 1 0 9.01 10 Z";
    out property <string> person: "M 12 4 A 3.2 3.2 0 1 0 12.01 4 Z M 5 20 C 5 15.5 8 13.5 12 13.5 C 16 13.5 19 15.5 19 20 Z";
    out property <string> vehicle: "M 3.5 16 V 12 L 6 7 H 18 L 20.5 12 V 16 Z M 3.5 12 H 20.5 M 7 16 V 18.5 M 17 16 V 18.5";
    out property <string> animal: "M 7 9 A 1.6 1.6 0 1 0 7.01 9 Z M 17 9 A 1.6 1.6 0 1 0 17.01 9 Z M 10 5.5 A 1.6 1.6 0 1 0 10.01 5.5 Z M 14 5.5 A 1.6 1.6 0 1 0 14.01 5.5 Z M 12 12 C 9 12 7.5 15 7.5 17 C 7.5 19 9.5 19 12 18.5 C 14.5 19 16.5 19 16.5 17 C 16.5 15 15 12 12 12 Z";
    out property <string> motion: "M 3 12 H 7 L 9.5 6 L 14 18 L 16.5 12 H 21";
    out property <string> side-panel: "M 4 5 H 20 V 19 H 4 Z M 15 5 V 19";
    out property <string> close: "M 6 6 L 18 18 M 18 6 L 6 18";
    out property <string> zoom-in: "M 10.5 4 A 6.5 6.5 0 1 0 10.51 4 Z M 15.5 15.5 L 20.5 20.5 M 8 10.5 H 13 M 10.5 8 V 13";
    out property <string> zoom-out: "M 10.5 4 A 6.5 6.5 0 1 0 10.51 4 Z M 15.5 15.5 L 20.5 20.5 M 8 10.5 H 13";
    out property <string> volume-on: "M 4 9.5 H 8 L 13 5 V 19 L 8 14.5 H 4 Z M 16.5 9 A 4.2 4.2 0 0 1 16.5 15 M 19 6.5 A 7.5 7.5 0 0 1 19 17.5";
    out property <string> volume-off: "M 4 9.5 H 8 L 13 5 V 19 L 8 14.5 H 4 Z M 16.5 9.5 L 21 14 M 21 9.5 L 16.5 14";
    out property <string> spotlight: "M 12 7 A 5 5 0 1 0 12.01 7 Z M 12 2 V 4.2 M 12 19.8 V 22 M 2 12 H 4.2 M 19.8 12 H 22 M 4.9 4.9 L 6.5 6.5 M 17.5 17.5 L 19.1 19.1 M 19.1 4.9 L 17.5 6.5 M 6.5 17.5 L 4.9 19.1";
    out property <string> moon: "M 19.5 14.5 A 7.5 7.5 0 1 1 9.5 4.5 A 6 6 0 0 0 19.5 14.5 Z";
    out property <string> track: "M 12 4 A 8 8 0 1 0 12.01 4 Z M 12 9 A 3 3 0 1 0 12.01 9 Z M 12 2 V 5 M 12 19 V 22 M 2 12 H 5 M 19 12 H 22";
    out property <string> siren: "M 6 17 H 18 M 7.5 17 V 12 A 4.5 4.5 0 0 1 16.5 12 V 17 M 12 3 V 5 M 5 6 L 6.5 7.5 M 19 6 L 17.5 7.5 M 3 12 H 5 M 19 12 H 21";
    out property <string> power: "M 12 3.5 V 11.5 M 7.5 6.2 A 7 7 0 1 0 16.5 6.2";
    out property <string> trash: "M 4.5 7 H 19.5 M 9.5 7 V 4.5 H 14.5 V 7 M 6.5 7 L 7.5 19.5 H 16.5 L 17.5 7";
    out property <string> globe: "M 12 3 A 9 9 0 1 0 12.01 3 Z M 3.5 12 H 20.5 M 12 3 C 14.8 6 14.8 18 12 21 C 9.2 18 9.2 6 12 3";
    out property <string> faces: "M 4 8 V 4 H 8 M 16 4 H 20 V 8 M 20 16 V 20 H 16 M 8 20 H 4 V 16 M 12 8 A 2.5 2.5 0 1 0 12.01 8 Z M 8 17.5 C 8 15 9.8 14 12 14 C 14.2 14 16 15 16 17.5";
}

component Icon inherits Path {
    in property <brush> color: Palette.foreground;
    width: 22px;
    height: 22px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.color;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    fill: transparent;
}

component SideNavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    callback clicked();
    height: 46px;
    border-radius: 23px;
    background: root.active ? Palette.accent-background.transparentize(0.82)
        : ta.has-hover ? Palette.foreground.transparentize(0.93) : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Icon {
                commands: root.icon;
                color: root.active ? Palette.accent-background : Palette.foreground.transparentize(0.3);
            }
        }
        Text {
            text: root.text;
            font-size: 15px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            color: root.active ? Palette.accent-background : Palette.foreground;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Sidebar inherits Rectangle {
    width: 236px;
    background: Palette.alternate-background;
    VerticalLayout {
        padding: 14px;
        padding-top: Bridge.custom-chrome ? 28px : 20px;
        spacing: 6px;
        HorizontalLayout {
            padding-left: 8px;
            padding-bottom: 18px;
            spacing: 12px;
            AppMark { size: 38px; }
            VerticalLayout {
                alignment: center;
                Text { text: "Tapas"; font-size: 17px; font-weight: 700; }
                Text {
                    text: Bridge.account-name;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.4);
                    overflow: elide;
                }
            }
        }
        SideNavItem {
            text: Tr.nav-home;
            icon: Icons.home;
            active: Bridge.page == Page.home;
            clicked => { Bridge.navigate(Page.home); }
        }
        SideNavItem {
            text: Tr.nav-live;
            icon: Icons.grid;
            active: Bridge.page == Page.live;
            clicked => { Bridge.navigate(Page.live); }
        }
        SideNavItem {
            text: Tr.nav-playback;
            icon: Icons.playback;
            active: Bridge.page == Page.recordings;
            clicked => { Bridge.navigate(Page.recordings); }
        }
        if Bridge.hubs.length > 0: SideNavItem {
            text: Tr.nav-people;
            icon: Icons.faces;
            active: Bridge.page == Page.people;
            clicked => { Bridge.navigate(Page.people); }
        }
        SideNavItem {
            text: Tr.nav-settings;
            icon: Icons.settings;
            active: Bridge.page == Page.settings;
            clicked => { Bridge.navigate(Page.settings); }
        }
        Rectangle { vertical-stretch: 1; }
    }
}

component PageHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    height: Bridge.custom-chrome ? 90px : 76px;
    padding-left: 28px;
    padding-right: 24px;
    padding-top: Bridge.custom-chrome ? 32px : 12px;
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        spacing: 0px;
        Text {
            text: root.title;
            font-size: 28px;
            font-weight: 700;
            overflow: elide;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            font-size: 13px;
            color: Palette.foreground.transparentize(0.45);
            overflow: elide;
        }
    }
    Rectangle { horizontal-stretch: 1; }
    @children
}

component RoundIconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <brush> icon-color: Palette.foreground;
    in property <brush> base: Palette.foreground.transparentize(0.94);
    in property <bool> enabled: true;
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: !root.enabled ? root.base : ta.pressed ? root.base.darker(0.2) : ta.has-hover ? root.base.darker(0.1) : root.base;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    Icon { commands: root.icon; color: root.icon-color; }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        changed has-hover => {
            if (self.has-hover && root.label != "") {
                Bridge.tip-text = root.label;
                Bridge.tip-x = root.absolute-position.x + root.width / 2;
                Bridge.tip-y = root.absolute-position.y;
            } else if (Bridge.tip-text == root.label) {
                Bridge.tip-text = "";
            }
        }
        clicked => {
            Bridge.tip-text = "";
            root.clicked();
        }
    }
}

// A rounded accent button with an icon, e.g. "Live view" on Home.
component AccentChip inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    callback clicked();
    height: 40px;
    horizontal-stretch: 0;
    border-radius: 20px;
    background: ta.pressed ? Palette.accent-background.darker(0.15) : ta.has-hover ? Palette.accent-background.darker(0.07) : Palette.accent-background;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 20px;
        spacing: 8px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Icon { commands: root.icon; color: Palette.accent-foreground; width: 20px; height: 20px; }
        }
        Text { text: root.text; color: Palette.accent-foreground; font-weight: 600; vertical-alignment: center; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Floating notification pill shown over any page, including Single view & fullscreen.
component FloatingToast inherits Rectangle {
    in property <length> max-w: 580px;
    width: min(self.max-w, row.preferred-width + 24px);
    height: 40px;
    border-radius: 20px;
    background: #1b1b1fec;
    border-width: 1px;
    border-color: #ffffff28;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000048;
    row := HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        spacing: 10px;
        alignment: center;
        Text {
            text: Bridge.status-text;
            color: white;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if Bridge.status-action-path != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 26px;
                width: act-lbl.preferred-width + 18px;
                border-radius: 13px;
                background: act-ta.pressed ? Palette.accent-background.darker(0.15)
                    : act-ta.has-hover ? Palette.accent-background.brighter(0.08)
                    : Palette.accent-background;
                act-lbl := Text {
                    text: Tr.show-in-folder;
                    color: Palette.accent-foreground;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                act-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Bridge.show-in-folder(Bridge.status-action-path);
                        Bridge.clear-status();
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: cls-ta.has-hover ? #ffffff24 : transparent;
                Icon { commands: Icons.close; width: 13px; height: 13px; color: #ffffffc0; }
                cls-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Bridge.clear-status(); }
                }
            }
        }
    }
}

// Over a picture that isn't live yet: dimmed, with what's happening.
component ConnectingVeil inherits Rectangle {
    in property <string> text;
    background: #00000078;
    Rectangle {
        width: min(parent.width - 24px, row.preferred-width + 28px);
        height: 34px;
        border-radius: 17px;
        background: #000000b8;
        row := HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            spacing: 8px;
            alignment: center;
            VerticalLayout {
                alignment: center;
                Spinner { width: 16px; height: 16px; indeterminate: true; }
            }
            Text {
                text: root.text;
                color: white;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

component VideoTile inherits Rectangle {
    in property <Tile> tile;
    callback clicked();
    callback toggle-audio();
    background: #0d0d0d;
    border-radius: 8px;
    clip: true;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.tile.frame;
        image-fit: contain;
    }
    if root.tile.has-frame && root.tile.stale: ConnectingVeil { text: root.tile.status; }
    if !root.tile.has-frame: Text {
        x: 16px;
        width: parent.width - 32px;
        height: parent.height;
        text: root.tile.status;
        color: #9a9a9a;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    Rectangle {
        border-radius: 8px;
        border-width: ta.has-hover ? 2px : 0px;
        border-color: Palette.accent-background;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
    Rectangle {
        y: parent.height - self.height;
        width: parent.width;
        height: 32px;
        background: #000000b0;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 6px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 9px;
                    height: 9px;
                    border-radius: 4.5px;
                    background: root.tile.live ? #2ecc71 : #f39c12;
                }
            }
            Text { text: root.tile.name; color: white; font-weight: 600; vertical-alignment: center; }
            Text {
                // With no picture yet the message is shown in the middle instead.
                text: root.tile.has-frame && !root.tile.stale ? root.tile.status : "";
                color: #c8c8c8;
                horizontal-stretch: 1;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 26px;
                    height: 24px;
                    border-radius: 6px;
                    background: root.tile.audio-on ? Palette.accent-background : ata.has-hover ? #ffffff30 : transparent;
                    Icon {
                        width: 15px;
                        height: 15px;
                        commands: root.tile.audio-on ? Icons.volume-on : Icons.volume-off;
                        color: root.tile.audio-on ? Palette.accent-foreground : #d8d8d8;
                    }
                    ata := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.toggle-audio(); }
                    }
                }
            }
        }
    }
}

component CameraCard inherits Rectangle {
    in property <HomeCard> card;
    callback clicked();
    callback playback();
    border-radius: 16px;
    background: Palette.control-background;
    border-width: 1px;
    border-color: ta.has-hover ? Palette.accent-background : Palette.border;
    clip: true;
    accessible-role: button;
    accessible-label: "Open " + root.card.name;
    accessible-action-default => { root.clicked(); }
    // Under the buttons, so they get their own clicks.
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    preview := Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.width * 9 / 16;
        background: #141416;
        if root.card.has-thumb: Image {
            width: parent.width;
            height: parent.height;
            source: root.card.thumb;
            image-fit: cover;
        }
        if !root.card.has-thumb: Icon {
            width: 44px;
            height: 44px;
            commands: Icons.video;
            color: #ffffff40;
        }
        if root.card.state != "": Rectangle {
            x: 10px;
            y: 10px;
            width: badge.preferred-width + 20px;
            height: 24px;
            border-radius: 12px;
            background: #000000b0;
            badge := Text {
                text: root.card.state;
                color: white;
                font-size: 12px;
                font-weight: 600;
            }
        }
    }
    HorizontalLayout {
        y: preview.height;
        height: parent.height - preview.height;
        padding-left: 16px;
        padding-right: 14px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: root.card.name; font-size: 16px; font-weight: 600; overflow: elide; }
            HorizontalLayout {
                spacing: 6px;
                if root.card.room != "": Text {
                    text: root.card.room;
                    font-size: 13px;
                    color: Palette.foreground.transparentize(0.25);
                    overflow: elide;
                }
                if root.card.room != "" && root.card.detail != "": Text {
                    text: "·";
                    font-size: 13px;
                    color: Palette.foreground.transparentize(0.55);
                }
                Text {
                    text: root.card.detail;
                    font-size: 13px;
                    color: Palette.foreground.transparentize(0.45);
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
        if root.card.playback: VerticalLayout {
            alignment: center;
            RoundIconButton {
                icon: Icons.playback;
                label: Tr.recordings-of-prefix + root.card.name;
                clicked => { root.playback(); }
            }
        }
        VerticalLayout {
            alignment: center;
            RoundIconButton {
                icon: Icons.video;
                label: Tr.watch-prefix + root.card.name;
                icon-color: Palette.accent-foreground;
                base: Palette.accent-background;
                clicked => { root.clicked(); }
            }
        }
    }
}

component HubCard inherits Rectangle {
    in property <HubRow> hub;
    callback open();
    callback toggle-loop();
    callback toggle-alarm();
    border-radius: 16px;
    background: Palette.control-background;
    border-width: 1px;
    border-color: Palette.border;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 14px;
            Rectangle {
                width: 46px;
                height: 46px;
                border-radius: 12px;
                background: Palette.accent-background.transparentize(0.85);
                Icon { commands: Icons.hub; color: Palette.accent-background; }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: root.hub.name; font-size: 16px; font-weight: 600; overflow: elide; }
                HorizontalLayout {
                    spacing: 6px;
                    if root.hub.room != "": Text {
                        text: root.hub.room;
                        font-size: 13px;
                        color: Palette.foreground.transparentize(0.25);
                    }
                    if root.hub.room != "": Text { text: "·"; font-size: 13px; color: Palette.foreground.transparentize(0.55); }
                    Text {
                        text: root.hub.detail;
                        font-size: 13px;
                        color: Palette.foreground.transparentize(0.45);
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                AccentChip {
                    text: Tr.nav-playback;
                    icon: Icons.playback;
                    clicked => { root.open(); }
                }
            }
        }
        // Its main disk: how full, as in the Tapo app's Hub Storage.
        if root.hub.loaded && root.hub.disk != "": VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: root.hub.disk; font-size: 13px; font-weight: 600; }
                if root.hub.health != "": Text {
                    text: "·  " + root.hub.health;
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.45);
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.hub.space;
                    font-size: 13px;
                    color: Palette.foreground.transparentize(0.35);
                }
            }
            if root.hub.used >= 0: Rectangle {
                height: 8px;
                border-radius: 4px;
                background: Palette.foreground.transparentize(0.9);
                Rectangle {
                    x: 0;
                    width: max(8px, parent.width * root.hub.used);
                    border-radius: 4px;
                    // Amber when it's full and not recording over the oldest.
                    background: root.hub.warn ? #e8a317 : Palette.accent-background;
                }
            }
        }
        if root.hub.loaded && root.hub.note != "": Text {
            text: root.hub.note;
            font-size: 12px;
            color: Palette.foreground.transparentize(0.45);
            wrap: word-wrap;
        }
        if root.hub.loaded: HorizontalLayout {
            spacing: 12px;
            if root.hub.loop-known: HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: Tr.loop-recording;
                        font-size: 12px;
                        color: Palette.foreground.transparentize(0.25);
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Switch {
                        checked: root.hub.loop-on;
                        enabled: !root.hub.busy;
                        toggled => { root.toggle-loop(); }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.hub.busy: VerticalLayout {
                alignment: center;
                Spinner { width: 16px; height: 16px; indeterminate: true; }
            }
            Rectangle {
                height: 30px;
                width: hub-alarm-row.preferred-width + 20px;
                border-radius: 15px;
                background: root.hub.alarm-on ? #e5484d : hat.has-hover ? Palette.foreground.transparentize(0.88) : Palette.foreground.transparentize(0.93);
                hub-alarm-row := HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            width: 15px;
                            height: 15px;
                            commands: Icons.siren;
                            color: root.hub.alarm-on ? white : Palette.foreground;
                        }
                    }
                    Text {
                        text: root.hub.alarm-on ? Tr.stop-alarm : Tr.ring-hub;
                        font-size: 12px;
                        font-weight: 600;
                        color: root.hub.alarm-on ? white : Palette.foreground;
                        vertical-alignment: center;
                    }
                }
                hat := TouchArea {
                    enabled: !root.hub.busy;
                    mouse-cursor: pointer;
                    clicked => { root.toggle-alarm(); }
                }
            }
        }
        if !root.hub.loaded: HorizontalLayout {
            spacing: 8px;
            Spinner { width: 14px; height: 14px; indeterminate: true; }
            Text {
                text: Tr.asking-storage;
                font-size: 12px;
                color: Palette.foreground.transparentize(0.45);
                vertical-alignment: center;
            }
        }
    }
}

component SectionTitle inherits Text {
    font-size: 15px;
    font-weight: 600;
    color: Palette.foreground.transparentize(0.25);
}

component HomePage inherits Rectangle {
    property <length> gap: 16px;
    // The width the cards share: the page minus its padding and a scroll bar.
    property <length> avail: root.width - 28px - 24px - 14px;
    property <int> cols: max(1, Math.floor((self.avail + self.gap) / (280px + self.gap)));
    property <length> card-w: (self.avail - (self.cols - 1) * self.gap) / self.cols;
    property <length> card-h: self.card-w * 9 / 16 + 74px;
    property <int> rows: Math.ceil(Bridge.home-cameras.length / self.cols);
    VerticalLayout {
        PageHeader {
            title: Bridge.home-title;
            subtitle: Bridge.home-subtitle;
            if Bridge.cloud-busy: VerticalLayout {
                alignment: center;
                Spinner { width: 22px; height: 22px; indeterminate: true; }
            }
            VerticalLayout {
                alignment: center;
                RoundIconButton {
                    icon: Icons.refresh;
                    label: Tr.update-camera-list;
                    enabled: !Bridge.cloud-busy;
                    clicked => { Bridge.cloud-refresh(); }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                AccentChip {
                    text: Tr.nav-live;
                    icon: Icons.grid;
                    clicked => { Bridge.navigate(Page.live); }
                }
            }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 28px;
                padding-right: 24px;
                padding-top: 8px;
                padding-bottom: 28px;
                spacing: 14px;
                alignment: start;
                if Bridge.update-available && !Bridge.update-dismissed: Rectangle {
                    border-radius: 12px;
                    background: Palette.accent-background.transparentize(0.85);
                    border-width: 1px;
                    border-color: Palette.accent-background.transparentize(0.5);
                    HorizontalLayout {
                        padding: 10px;
                        padding-left: 16px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: Bridge.update-busy || Bridge.update-failed ? Bridge.update-status : "Tapas " + Bridge.update-version + Tr.update-available-suffix;
                                font-weight: 600;
                                overflow: elide;
                            }
                        }
                        if Bridge.update-busy: VerticalLayout {
                            alignment: center;
                            Spinner { width: 20px; height: 20px; indeterminate: true; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: Tr.update-now;
                                primary: true;
                                enabled: !Bridge.update-busy;
                                clicked => { Bridge.install-update(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: Tr.later;
                                enabled: !Bridge.update-busy;
                                clicked => { Bridge.update-dismissed = true; }
                            }
                        }
                    }
                }
                if Bridge.hubs.length > 0: SectionTitle { text: Tr.hub-section; }
                if Bridge.hubs.length > 0: HorizontalLayout {
                    spacing: root.gap;
                    alignment: start;
                    for h[i] in Bridge.hubs: HubCard {
                        width: min(560px, root.avail);
                        hub: h;
                        open => { Bridge.open-hub(i); }
                        toggle-loop => { Bridge.hub-toggle-loop(i); }
                        toggle-alarm => { Bridge.hub-toggle-alarm(i); }
                    }
                }
                if Bridge.hubs.length > 0: Rectangle { height: 6px; }
                SectionTitle {
                    text: Bridge.home-cameras.length == 0 ? Tr.cameras-section : Tr.cameras-section + "  ·  " + Bridge.home-cameras.length;
                }
                if Bridge.home-cameras.length == 0: Muted {
                    text: Tr.no-cameras-home;
                }
                Rectangle {
                    height: root.rows * (root.card-h + root.gap) - (root.rows > 0 ? root.gap : 0px);
                    for c[i] in Bridge.home-cameras: CameraCard {
                        x: Math.mod(i, root.cols) * (root.card-w + root.gap);
                        y: Math.floor(i / root.cols) * (root.card-h + root.gap);
                        width: root.card-w;
                        height: root.card-h;
                        card: c;
                        clicked => { Bridge.open-camera(c.id); }
                        playback => { Bridge.open-camera-playback(c.id); }
                    }
                }
            }
        }
    }
}

component LivePage inherits Rectangle {
    VerticalLayout {
        if !Bridge.fullscreen: PageHeader {
            title: Tr.nav-live;
            VerticalLayout {
                alignment: center;
                RoundIconButton {
                    icon: Icons.fullscreen;
                    label: Tr.fullscreen-hint;
                    clicked => { Bridge.toggle-fullscreen(); }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            if Bridge.tiles.length == 0: VerticalLayout {
                alignment: center;
                spacing: 12px;
                padding: 40px;
                Text { text: Tr.no-cameras-title; font-size: 22px; font-weight: 600; horizontal-alignment: center; }
                Muted {
                    horizontal-alignment: center;
                    text: Tr.no-cameras-live;
                }
            }
            Rectangle {
                property <length> pad: Bridge.fullscreen ? 4px : 10px;
                property <int> cols: max(1, Bridge.columns);
                property <int> rows: max(1, Math.ceil(Bridge.tiles.length / cols));
                property <length> gap: Bridge.fullscreen ? 4px : 10px;
                property <length> avail-w: (self.width - (cols - 1) * gap) / cols;
                property <length> avail-h: (self.height - (rows - 1) * gap) / rows;
                property <length> cell-w: min(avail-w, avail-h * 16 / 9);
                property <length> cell-h: cell-w * 9 / 16;
                property <length> off-x: (self.width - cols * cell-w - (cols - 1) * gap) / 2;
                property <length> off-y: (self.height - rows * cell-h - (rows - 1) * gap) / 2;
                x: pad;
                y: pad;
                width: parent.width - 2 * pad;
                height: parent.height - 2 * pad;
                for t[i] in Bridge.tiles: VideoTile {
                    x: off-x + Math.mod(i, cols) * (cell-w + gap);
                    y: off-y + Math.floor(i / cols) * (cell-h + gap);
                    width: cell-w;
                    height: cell-h;
                    tile: t;
                    clicked => { Bridge.open-camera(t.id); }
                    toggle-audio => { Bridge.toggle-tile-audio(t.id); }
                }
            }
        }
    }
}

// An action in the camera view's side panel.
component ActionTile inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> active;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback clicked();
    height: 92px;
    border-radius: 14px;
    background: root.active ? (root.danger ? #e5484d30 : Palette.accent-background.transparentize(0.8))
        : ta.has-hover && root.enabled ? Palette.foreground.transparentize(0.88) : Palette.foreground.transparentize(0.93);
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    VerticalLayout {
        alignment: center;
        spacing: 10px;
        HorizontalLayout {
            alignment: center;
            Icon {
                width: 26px;
                height: 26px;
                commands: root.icon;
                color: root.active ? (root.danger ? #e5484d : Palette.accent-background) : Palette.foreground;
            }
        }
        Text {
            text: root.text;
            font-size: 13px;
            horizontal-alignment: center;
            color: root.active ? (root.danger ? #e5484d : Palette.accent-background) : Palette.foreground.transparentize(0.15);
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component PadButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    callback clicked();
    width: 60px;
    height: 60px;
    border-radius: 30px;
    background: t.pressed ? Palette.accent-background.transparentize(0.7) : t.has-hover ? Palette.foreground.transparentize(0.9) : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Icon { commands: root.icon; width: 26px; height: 26px; }
    t := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Round pad: one press moves by the step; the arrow keys do the same.
component PtzPad inherits Rectangle {
    width: 196px;
    height: 196px;
    border-radius: 98px;
    background: Palette.foreground.transparentize(0.93);
    PadButton {
        x: (parent.width - self.width) / 2;
        y: 6px;
        icon: Icons.chevron-up;
        label: "Tilt up";
        clicked => { Bridge.ptz-move(0, Bridge.ptz-step); }
    }
    PadButton {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 6px;
        icon: Icons.chevron-down;
        label: "Tilt down";
        clicked => { Bridge.ptz-move(0, -Bridge.ptz-step); }
    }
    PadButton {
        x: 6px;
        y: (parent.height - self.height) / 2;
        icon: Icons.chevron-left;
        label: "Pan left";
        clicked => { Bridge.ptz-move(-Bridge.ptz-step, 0); }
    }
    PadButton {
        x: parent.width - self.width - 6px;
        y: (parent.height - self.height) / 2;
        icon: Icons.chevron-right;
        label: "Pan right";
        clicked => { Bridge.ptz-move(Bridge.ptz-step, 0); }
    }
    Rectangle {
        width: 56px;
        height: 56px;
        border-radius: 28px;
        background: Palette.foreground.transparentize(0.9);
        Spinner { width: 24px; height: 24px; indeterminate: true; visible: Bridge.ptz-busy; }
    }
}

component PtzSection inherits VerticalLayout {
    spacing: 12px;
    HorizontalLayout {
        alignment: center;
        PtzPad { }
    }
    Text {
        text: Tr.step-hint-prefix + Bridge.ptz-step + Tr.step-hint-suffix;
        font-size: 12px;
        horizontal-alignment: center;
        color: Palette.foreground.transparentize(0.4);
    }
    Slider {
        minimum: 5;
        maximum: 60;
        value: Bridge.ptz-step;
        changed(v) => { Bridge.ptz-step = Math.round(v); }
    }
    HorizontalLayout {
        spacing: 6px;
        Button {
            text: Tr.pan-patrol;
            horizontal-stretch: 1;
            enabled: !Bridge.ptz-busy;
            clicked => { Bridge.patrol-start(0); }
        }
        Button {
            text: Tr.tilt-patrol;
            horizontal-stretch: 1;
            enabled: !Bridge.ptz-busy;
            clicked => { Bridge.patrol-start(1); }
        }
        if Bridge.single-patrolling: Button {
            text: Tr.stop;
            primary: true;
            enabled: !Bridge.ptz-busy;
            clicked => { Bridge.patrol-stop(); }
        }
    }
    HorizontalLayout {
        Text { text: Tr.presets; font-size: 15px; font-weight: 600; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        LinkText { text: Tr.refresh; clicked => { Bridge.ptz-refresh(); } }
    }
    if Bridge.presets.length == 0: Text {
        text: Tr.no-presets;
        font-size: 12px;
        wrap: word-wrap;
        color: Palette.foreground.transparentize(0.4);
    }
    for p in Bridge.presets: Rectangle {
        height: 40px;
        border-radius: 10px;
        background: pt.has-hover ? Palette.foreground.transparentize(0.88) : Palette.foreground.transparentize(0.93);
        accessible-role: button;
        accessible-label: p.name;
        accessible-action-default => { Bridge.ptz-goto(p.id); }
        pt := TouchArea {
            mouse-cursor: pointer;
            clicked => { Bridge.ptz-goto(p.id); }
        }
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 6px;
            spacing: 6px;
            Text { text: p.name; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 7px;
                    background: del.has-hover ? #e5484d30 : transparent;
                    Icon {
                        commands: Icons.trash;
                        width: 15px;
                        height: 15px;
                        color: del.has-hover ? #e5484d : Palette.foreground.transparentize(0.45);
                    }
                    del := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { Bridge.ptz-delete(p.id); }
                    }
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 6px;
        preset-name := LineEdit { placeholder-text: Tr.preset-placeholder; }
        Button {
            text: Tr.save;
            enabled: preset-name.text != "";
            clicked => {
                Bridge.ptz-save(preset-name.text);
                preset-name.text = "";
            }
        }
    }
}

// Interactive scroll-wheel digital zoom (1x-8x) and click-drag pan overlay
// for Single live view and Playback player viewports.
component ZoomPanArea inherits TouchArea {
    in property <bool> has-click: false;
    callback single-clicked();
    callback double-clicked-unzoomed();
    property <bool> dragging: false;
    property <bool> dragged: false;
    property <float> drag-start-x: 0;
    property <float> drag-start-y: 0;
    property <float> prev-zoom: 1.0;
    mouse-cursor: Bridge.video-zoom > 1.01
        ? (root.dragging ? MouseCursor.grabbing : MouseCursor.grab)
        : MouseCursor.default;
    scroll-event(e) => {
        if (root.width <= 0px || root.height <= 0px) {
            return reject;
        }
        root.prev-zoom = Bridge.video-zoom;
        if (e.delta-y > 0) {
            Bridge.video-zoom = min(8.0, Bridge.video-zoom * 1.25);
        } else if (e.delta-y < 0) {
            Bridge.video-zoom = Bridge.video-zoom / 1.25;
            if (Bridge.video-zoom < 1.05) {
                Bridge.video-zoom = 1.0;
            }
        }
        if (Bridge.video-zoom <= 1.01) {
            Bridge.video-zoom = 1.0;
            Bridge.video-pan-x = 0.0;
            Bridge.video-pan-y = 0.0;
        } else {
            Bridge.video-pan-x = max(
                -(Bridge.video-zoom - 1.0) / 2.0,
                min(
                    (Bridge.video-zoom - 1.0) / 2.0,
                    (self.mouse-x / root.width - 0.5) - ((self.mouse-x / root.width - 0.5) - Bridge.video-pan-x) * (Bridge.video-zoom / root.prev-zoom)
                )
            );
            Bridge.video-pan-y = max(
                -(Bridge.video-zoom - 1.0) / 2.0,
                min(
                    (Bridge.video-zoom - 1.0) / 2.0,
                    (self.mouse-y / root.height - 0.5) - ((self.mouse-y / root.height - 0.5) - Bridge.video-pan-y) * (Bridge.video-zoom / root.prev-zoom)
                )
            );
        }
        accept
    }
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
            root.dragged = false;
            root.dragging = false;
            root.drag-start-x = Bridge.video-pan-x;
            root.drag-start-y = Bridge.video-pan-y;
        } else if (e.kind == PointerEventKind.up) {
            root.dragging = false;
        }
    }
    moved => {
        if (self.pressed && Bridge.video-zoom > 1.01 && root.width > 0px && root.height > 0px) {
            if (!root.dragging && (abs(self.mouse-x - self.pressed-x) > 3px || abs(self.mouse-y - self.pressed-y) > 3px)) {
                root.dragging = true;
                root.dragged = true;
            }
            if (root.dragging) {
                Bridge.video-pan-x = max(
                    -(Bridge.video-zoom - 1.0) / 2.0,
                    min((Bridge.video-zoom - 1.0) / 2.0, root.drag-start-x + (self.mouse-x - self.pressed-x) / root.width)
                );
                Bridge.video-pan-y = max(
                    -(Bridge.video-zoom - 1.0) / 2.0,
                    min((Bridge.video-zoom - 1.0) / 2.0, root.drag-start-y + (self.mouse-y - self.pressed-y) / root.height)
                );
            }
        }
    }
    clicked => {
        if (!root.dragged && root.has-click) {
            root.single-clicked();
        }
    }
    double-clicked => {
        if (Bridge.video-zoom > 1.01) {
            Bridge.reset-zoom();
        } else {
            root.double-clicked-unzoomed();
        }
    }
}

component ZoomResetPill inherits Rectangle {
    property <int> tenths: Math.round(Bridge.video-zoom * 10);
    property <int> whole: Math.floor(self.tenths / 10);
    property <int> frac: self.tenths - self.whole * 10;
    width: pill-row.preferred-width + 20px;
    height: 30px;
    border-radius: 15px;
    background: ta.pressed ? #000000e0 : ta.has-hover ? #000000d0 : #000000a8;
    border-width: 1px;
    border-color: #ffffff30;
    accessible-role: button;
    accessible-label: Tr.reset-zoom;
    accessible-action-default => { Bridge.reset-zoom(); }
    pill-row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Icon { commands: Icons.zoom-in; width: 14px; height: 14px; color: white; }
        }
        Text {
            text: root.whole + "." + root.frac + "×";
            color: white;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Icon { commands: Icons.close; width: 12px; height: 12px; color: #ffffffb0; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Bridge.reset-zoom(); }
    }
}

component SinglePage inherits Rectangle {
    background: black;
    HorizontalLayout {
        Rectangle {
            horizontal-stretch: 1;
            background: black;
            clip: true;
            Image {
                width: parent.width * Bridge.video-zoom;
                height: parent.height * Bridge.video-zoom;
                x: (parent.width - self.width) / 2 + Bridge.video-pan-x * parent.width;
                y: (parent.height - self.height) / 2 + Bridge.video-pan-y * parent.height;
                source: Bridge.single-frame;
                image-fit: contain;
            }
            if Bridge.single-has-frame && Bridge.single-stale && !Bridge.single-privacy: ConnectingVeil { text: Bridge.single-status; }
            if !Bridge.single-has-frame && !Bridge.single-privacy: Text {
                x: 20px;
                width: parent.width - 40px;
                height: parent.height;
                text: Bridge.single-status;
                color: #9a9a9a;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            ZoomPanArea {
                enabled: !Bridge.single-privacy;
                double-clicked-unzoomed => { Bridge.toggle-fullscreen(); }
            }
            if Bridge.single-recording: Rectangle {
                x: 14px;
                y: Bridge.fullscreen ? 14px : (Bridge.custom-chrome ? 96px : 72px);
                width: live-rec-lbl.preferred-width + 34px;
                height: 30px;
                border-radius: 15px;
                background: #000000b8;
                border-width: 1px;
                border-color: #e5484d80;
                Rectangle { x: 12px; width: 10px; height: 10px; border-radius: 5px; background: #e5484d; }
                live-rec-lbl := Text {
                    x: 28px;
                    text: "REC " + Bridge.single-rec-time;
                    color: white;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            if Bridge.video-zoom > 1.01 && !Bridge.single-privacy: ZoomResetPill {
                x: parent.width - self.width - 14px;
                y: parent.height - self.height - 14px;
            }
            if Bridge.single-privacy: Rectangle {
                background: #0c0c0e;
                VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    HorizontalLayout {
                        alignment: center;
                        Icon { commands: Icons.privacy; width: 54px; height: 54px; color: #ffffffb0; }
                    }
                    Text { text: Tr.privacy-on-title; color: white; font-size: 20px; font-weight: 600; horizontal-alignment: center; }
                    Text {
                        text: Tr.privacy-on-desc;
                        color: #a8a8a8;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        padding-top: 8px;
                        PillButton {
                            width: 200px;
                            primary: true;
                            text: Tr.turn-off;
                            busy: Bridge.ptz-busy;
                            clicked => { Bridge.privacy-toggle(); }
                        }
                    }
                }
            }
            if !Bridge.fullscreen: Rectangle {
                y: 0;
                height: Bridge.custom-chrome ? 92px : 68px;
                background: @linear-gradient(180deg, #000000c8 0%, #00000000 100%);
                HorizontalLayout {
                    padding-top: Bridge.custom-chrome ? 28px : 0px;
                    padding-left: 10px;
                    padding-right: 16px;
                    padding-bottom: 8px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        RoundIconButton {
                            icon: Icons.back;
                            label: Tr.back;
                            icon-color: white;
                            base: #ffffff1a;
                            clicked => { Bridge.single-back(); }
                        }
                    }
                    if Bridge.single-can-switch: HorizontalLayout {
                        spacing: 4px;
                        VerticalLayout {
                            alignment: center;
                            RoundIconButton {
                                width: 32px;
                                height: 32px;
                                icon: Icons.chevron-left;
                                label: Tr.prev-camera;
                                icon-color: white;
                                base: #ffffff1a;
                                clicked => { Bridge.single-step-camera(-1); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            RoundIconButton {
                                width: 32px;
                                height: 32px;
                                icon: Icons.chevron-right;
                                label: Tr.next-camera;
                                icon-color: white;
                                base: #ffffff1a;
                                clicked => { Bridge.single-step-camera(1); }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text { text: Bridge.single-name; color: white; font-size: 18px; font-weight: 600; overflow: elide; }
                        Text { text: Bridge.single-status; color: #c0c0c0; font-size: 12px; overflow: elide; }
                    }
                    VerticalLayout {
                        alignment: center;
                        RoundIconButton {
                            icon: Icons.record;
                            label: Bridge.single-recording ? Tr.stop-save-recording : Tr.record-live;
                            icon-color: Bridge.single-recording ? #ff6b6b : white;
                            base: Bridge.single-recording ? #e5484d60 : #ffffff1a;
                            enabled: (Bridge.single-has-frame && !Bridge.single-stale && !Bridge.single-privacy) || Bridge.single-recording;
                            clicked => { Bridge.single-record(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        RoundIconButton {
                            icon: Bridge.single-audio-on ? Icons.volume-on : Icons.volume-off;
                            label: Bridge.single-audio-on ? Tr.mute-audio : Tr.listen-in;
                            icon-color: Bridge.single-audio-on ? Palette.accent-foreground : white;
                            base: Bridge.single-audio-on ? Palette.accent-background : #ffffff1a;
                            clicked => { Bridge.single-toggle-audio(); }
                        }
                    }
                    // SD/HD switch.
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 96px;
                            height: 32px;
                            border-radius: 16px;
                            background: #ffffff22;
                            HorizontalLayout {
                                padding: 3px;
                                for q[i] in Bridge.quality-labels: Rectangle {
                                    border-radius: 13px;
                                    background: Bridge.single-quality == i ? #ffffffe6 : transparent;
                                    accessible-role: button;
                                    accessible-label: q;
                                    accessible-action-default => {
                                        Bridge.single-quality = i;
                                        Bridge.quality-changed(i);
                                    }
                                    Text {
                                        text: q;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Bridge.single-quality == i ? black : white;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (Bridge.single-quality != i) {
                                                Bridge.single-quality = i;
                                                Bridge.quality-changed(i);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        RoundIconButton {
                            icon: Icons.fullscreen;
                            label: Tr.fullscreen-hint;
                            icon-color: white;
                            base: #ffffff1a;
                            clicked => { Bridge.toggle-fullscreen(); }
                        }
                    }
                }
            }
        }
        if !Bridge.fullscreen: Rectangle {
            width: 340px;
            background: Palette.alternate-background;
            ScrollView {
                VerticalLayout {
                    padding: 16px;
                    padding-top: Bridge.custom-chrome ? 40px : 16px;
                    spacing: 12px;
                    alignment: start;
                    GridLayout {
                        spacing: 10px;
                        Row {
                            ActionTile {
                                icon: Bridge.single-audio-on ? Icons.volume-on : Icons.volume-off;
                                text: Bridge.single-audio-on ? Tr.sound-on : Tr.sound-off;
                                active: Bridge.single-audio-on;
                                clicked => { Bridge.single-toggle-audio(); }
                            }
                            ActionTile {
                                icon: Icons.photo;
                                text: Tr.take-photo;
                                enabled: Bridge.single-has-frame && !Bridge.single-stale;
                                clicked => { Bridge.snapshot(); }
                            }
                        }
                        Row {
                            ActionTile {
                                icon: Icons.record;
                                text: Bridge.single-recording ? Tr.stop-recording : Tr.record-live;
                                active: Bridge.single-recording;
                                danger: true;
                                enabled: (Bridge.single-has-frame && !Bridge.single-stale && !Bridge.single-privacy) || Bridge.single-recording;
                                clicked => { Bridge.single-record(); }
                            }
                            ActionTile {
                                icon: Icons.move;
                                text: Tr.pan-tilt;
                                active: Bridge.ptz-open && Bridge.single-ptz && !Bridge.single-privacy;
                                enabled: Bridge.single-ptz && !Bridge.single-privacy;
                                clicked => { Bridge.ptz-open = !Bridge.ptz-open; }
                            }
                        }
                        Row {
                            ActionTile {
                                icon: Icons.privacy;
                                text: Tr.privacy-mode;
                                active: Bridge.single-privacy;
                                enabled: Bridge.single-privacy-known && !Bridge.ptz-busy;
                                clicked => { Bridge.privacy-toggle(); }
                            }
                            ActionTile {
                                icon: Icons.spotlight;
                                text: Bridge.single-spotlight ? Tr.spotlight-on : Tr.spotlight;
                                active: Bridge.single-spotlight;
                                enabled: !Bridge.single-privacy && !Bridge.ptz-busy;
                                clicked => { Bridge.spotlight-toggle(); }
                            }
                        }
                        Row {
                            ActionTile {
                                icon: Icons.track;
                                text: Bridge.single-track ? Tr.tracking-on : Tr.auto-track;
                                active: Bridge.single-track;
                                enabled: Bridge.single-ptz && !Bridge.single-privacy && !Bridge.ptz-busy;
                                clicked => { Bridge.auto-track-toggle(); }
                            }
                            ActionTile {
                                icon: Icons.siren;
                                text: Bridge.single-siren ? Tr.stop-siren : Tr.siren;
                                active: Bridge.single-siren;
                                danger: true;
                                enabled: !Bridge.ptz-busy;
                                clicked => { Bridge.siren-toggle(); }
                            }
                        }
                    }
                    if Bridge.ptz-open && Bridge.single-ptz && !Bridge.single-privacy: PtzSection { }
                    // Night vision selector.
                    Rectangle {
                        height: 52px;
                        border-radius: 12px;
                        background: Palette.foreground.transparentize(0.93);
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 10px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Icon { commands: Icons.moon; width: 20px; height: 20px; }
                            }
                            Text {
                                text: Tr.night-vision;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            VerticalLayout {
                                alignment: center;
                                ComboBox {
                                    width: 128px;
                                    model: Bridge.nv-labels;
                                    current-index <=> Bridge.single-nv-index;
                                    enabled: !Bridge.single-privacy && !Bridge.ptz-busy;
                                    selected => { Bridge.night-vision-changed(Bridge.single-nv-index); }
                                }
                            }
                        }
                    }
                    // Playback & Download: the camera's recordings on the hub.
                    Rectangle {
                        height: 58px;
                        border-radius: 14px;
                        background: pb.has-hover ? Palette.foreground.transparentize(0.88) : Palette.foreground.transparentize(0.93);
                        accessible-role: button;
                        accessible-label: Tr.playback-download;
                        accessible-action-default => { Bridge.open-playback(); }
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 14px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Icon { commands: Icons.playback; width: 24px; height: 24px; }
                            }
                            Text { text: Tr.playback-download; font-size: 15px; vertical-alignment: center; horizontal-stretch: 1; }
                            VerticalLayout {
                                alignment: center;
                                Icon { commands: Icons.chevron-right; width: 18px; height: 18px; color: Palette.foreground.transparentize(0.4); }
                            }
                        }
                        pb := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Bridge.open-playback(); }
                        }
                    }
                    // Reboot camera with 2-step confirmation.
                    if !Bridge.reboot-confirm: HorizontalLayout {
                        Button {
                            text: Tr.reboot-camera;
                            horizontal-stretch: 1;
                            enabled: !Bridge.ptz-busy;
                            clicked => { Bridge.reboot-confirm = true; }
                        }
                    }
                    if Bridge.reboot-confirm: Rectangle {
                        border-radius: 12px;
                        background: #e5484d1a;
                        border-width: 1px;
                        border-color: #e5484d60;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            Text {
                                text: Tr.reboot-confirm-prefix + Bridge.single-name + Tr.reboot-confirm-suffix;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Button {
                                    text: Tr.cancel;
                                    horizontal-stretch: 1;
                                    clicked => { Bridge.reboot-confirm = false; }
                                }
                                Button {
                                    text: Tr.confirm-reboot;
                                    primary: true;
                                    horizontal-stretch: 1;
                                    clicked => {
                                        Bridge.reboot-confirm = false;
                                        Bridge.camera-reboot();
                                    }
                                }
                            }
                        }
                    }
                    if Bridge.ptz-message != "": Text {
                        text: Bridge.ptz-message;
                        font-size: 12px;
                        wrap: word-wrap;
                        color: Palette.foreground.transparentize(0.35);
                    }
                }
            }
        }
    }
}

// A day in the Playback page's month calendar.
component DayButton inherits Rectangle {
    in property <DayChip> chip;
    callback clicked();
    height: 38px;
    border-radius: 19px;
    background: root.chip.selected ? Palette.accent-background
        : ta.has-hover && !root.chip.future ? Palette.foreground.transparentize(0.92) : transparent;
    opacity: root.chip.future ? 0.3 : root.chip.in-month ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.chip.day;
    accessible-action-default => { root.clicked(); }
    VerticalLayout {
        alignment: center;
        spacing: 1px;
        Text {
            text: root.chip.day;
            font-size: 14px;
            font-weight: root.chip.selected ? 700 : 500;
            horizontal-alignment: center;
            color: root.chip.selected ? Palette.accent-foreground : Palette.foreground;
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: !root.chip.has-video ? transparent
                    : root.chip.selected ? Palette.accent-foreground : Palette.accent-background;
            }
        }
    }
    ta := TouchArea {
        enabled: !root.chip.future;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A recording or detected event in the list (or an hour's heading): click
// to watch from it; the arrow saves it. In batch mode, clicking toggles selection.
component ClipRow inherits Rectangle {
    in property <RecRow> rec;
    in property <bool> batch-mode;
    callback play();
    callback save();
    callback toggle-select();
    height: root.rec.header ? 34px : root.rec.has-thumb ? 74px : 54px;
    border-radius: 10px;
    background: root.rec.header ? transparent
        : root.batch-mode && root.rec.selected ? Palette.accent-background.transparentize(0.84)
        : root.rec.playing ? Palette.accent-background.transparentize(0.85)
        : ta.has-hover ? Palette.foreground.transparentize(0.94) : transparent;
    if root.rec.header: Text {
        x: 6px;
        text: root.rec.time;
        font-size: 13px;
        font-weight: 600;
        color: Palette.foreground.transparentize(0.35);
        vertical-alignment: bottom;
        height: parent.height - 6px;
    }
    ta := TouchArea {
        enabled: !root.rec.header;
        mouse-cursor: pointer;
        clicked => {
            if (root.batch-mode) {
                root.toggle-select();
            } else {
                root.play();
            }
        }
    }
    if !root.rec.header: HorizontalLayout {
        padding-left: 6px;
        padding-right: 4px;
        spacing: 10px;
        if root.batch-mode: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                border-width: 1.5px;
                border-color: root.rec.selected ? Palette.accent-background : Palette.foreground.transparentize(0.55);
                background: root.rec.selected ? Palette.accent-background : transparent;
                if root.rec.selected: Icon {
                    width: 12px;
                    height: 12px;
                    commands: Icons.check;
                    color: Palette.accent-foreground;
                }
            }
        }
        if root.rec.has-thumb: Rectangle {
            width: root.batch-mode ? 96px : 112px;
            height: 63px;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            clip: true;
            background: #000;
            Image { width: parent.width; height: parent.height; source: root.rec.thumb; image-fit: cover; }
            Rectangle {
                x: parent.width - self.width - 4px;
                y: parent.height - self.height - 4px;
                width: dur.preferred-width + 8px;
                height: 16px;
                border-radius: 4px;
                background: #000000a0;
                dur := Text { text: root.rec.duration; color: white; font-size: 10px; vertical-alignment: center; }
            }
        }
        if !root.rec.has-thumb: Rectangle {
            width: 34px;
            height: 34px;
            y: (parent.height - self.height) / 2;
            border-radius: 17px;
            background: root.rec.playing ? Palette.accent-background : Palette.foreground.transparentize(0.92);
            Icon {
                commands: Icons.play;
                width: 16px;
                height: 16px;
                color: root.rec.playing ? Palette.accent-foreground : Palette.foreground;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 3px;
            Text {
                text: root.rec.camera != "" ? root.rec.time + "  ·  " + root.rec.camera : root.rec.time;
                font-weight: 600;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 6px;
                if root.rec.icon > 0: Icon {
                    width: 16px;
                    height: 16px;
                    commands: root.rec.icon == 1 ? Icons.person : root.rec.icon == 2 ? Icons.vehicle
                        : root.rec.icon == 3 ? Icons.animal : Icons.motion;
                    color: root.rec.icon == 4 ? #e8a317 : root.rec.icon == 3 ? #3aa757 : #4f86e8;
                }
                Text {
                    text: root.rec.kind + (root.rec.has-thumb ? "" : "  ·  " + root.rec.duration) + (root.rec.saved ? "  ·  " + Tr.saved-tag : "");
                    font-size: 12px;
                    color: Palette.foreground.transparentize(0.4);
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
        if !root.batch-mode: VerticalLayout {
            alignment: center;
            RoundIconButton {
                width: 32px;
                height: 32px;
                icon: root.rec.saved ? Icons.check : Icons.download;
                label: root.rec.saved ? Tr.saved-tooltip : Tr.save-to-videos;
                base: transparent;
                clicked => { root.save(); }
            }
        }
    }
}

// Clickable 24-hour activity sparkline above the Playback list: each bar is an
// hour of the day; clicking a non-zero bar jumps straight to that hour.
component ActivityChart inherits Rectangle {
    in property <[HourBar]> bars;
    in property <string> summary;
    callback jump(int);
    property <int> hover-hour: -1;
    property <int> hover-count: 0;
    height: 76px;
    border-radius: 10px;
    background: Palette.foreground.transparentize(0.955);
    border-width: 1px;
    border-color: Palette.border;
    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 5px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: Tr.activity-24h;
                font-size: 11px;
                font-weight: 600;
                color: Palette.foreground.transparentize(0.3);
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.hover-hour >= 0
                    ? (root.hover-hour < 10 ? "0" : "") + root.hover-hour + ":00  ·  " + root.hover-count
                    : root.summary;
                font-size: 11px;
                color: root.hover-hour >= 0 ? Palette.accent-background : Palette.foreground.transparentize(0.45);
                font-weight: root.hover-hour >= 0 ? 600 : 400;
            }
        }
        HorizontalLayout {
            height: 32px;
            spacing: 2px;
            for bar in root.bars: Rectangle {
                horizontal-stretch: 1;
                background: transparent;
                Rectangle {
                    y: parent.height - self.height;
                    width: parent.width;
                    height: bar.count > 0 ? max(4px, parent.height * bar.ratio) : 2px;
                    border-radius: 2px;
                    background: bar.count == 0
                        ? Palette.foreground.transparentize(0.88)
                        : bta.has-hover ? Palette.accent-background
                        : bar.peak ? Palette.accent-background.transparentize(0.1)
                        : Palette.accent-background.transparentize(0.42);
                }
                bta := TouchArea {
                    mouse-cursor: bar.count > 0 ? pointer : default;
                    changed has-hover => {
                        if (self.has-hover) {
                            root.hover-hour = bar.hour;
                            root.hover-count = bar.count;
                        } else if (root.hover-hour == bar.hour) {
                            root.hover-hour = -1;
                        }
                    }
                    clicked => {
                        if (bar.count > 0) {
                            root.jump(bar.hour);
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            Text { text: "00"; font-size: 9px; color: Palette.foreground.transparentize(0.5); }
            Rectangle { horizontal-stretch: 1; }
            Text { text: "06"; font-size: 9px; color: Palette.foreground.transparentize(0.5); }
            Rectangle { horizontal-stretch: 1; }
            Text { text: "12"; font-size: 9px; color: Palette.foreground.transparentize(0.5); }
            Rectangle { horizontal-stretch: 1; }
            Text { text: "18"; font-size: 9px; color: Palette.foreground.transparentize(0.5); }
            Rectangle { horizontal-stretch: 1; }
            Text { text: "23"; font-size: 9px; color: Palette.foreground.transparentize(0.5); }
        }
    }
}

// The day under the video: recordings (blue) and events (amber). Click to
// watch from a moment, drag the white playhead to a moment, drag elsewhere
// to move along the day, scroll to zoom.
component Timeline inherits Rectangle {
    // Over the picture in full screen.
    in property <bool> overlay;
    // Moving along the day.
    property <bool> dragging;
    // Dragging the playhead: where it is, as a part of the width (-1: not).
    property <float> scrub: -1;
    // Set when a press ended a playhead drag, so it isn't also a click.
    property <bool> scrubbed;
    property <float> head: root.scrub >= 0 ? root.scrub : Bridge.tl-playhead;
    property <bool> head-shown: root.head >= 0 && root.head <= 1;
    // How close to the playhead a press grabs it.
    property <length> grab: 10px;
    property <bool> near-head: Bridge.tl-playhead >= 0 && Bridge.tl-playhead <= 1
        && abs(ta.mouse-x - Bridge.tl-playhead * root.width) <= root.grab;
    height: 70px;
    border-radius: 10px;
    background: root.overlay ? #000000a8 : #121418;
    clip: true;
    for t in Bridge.tl-ticks: Rectangle {
        x: t.x * root.width;
        y: 0;
        width: 1px;
        height: 7px;
        background: #ffffff50;
    }
    for t in Bridge.tl-ticks: Text {
        x: t.x * root.width - 24px;
        y: 8px;
        width: 48px;
        text: t.label;
        color: #ffffffa0;
        font-size: 11px;
        horizontal-alignment: center;
    }
    Rectangle {
        y: 28px;
        height: root.height - 34px;
        background: #1c2027;
        for seg in Bridge.tl-segments: Rectangle {
            x: seg.x * root.width;
            width: max(seg.event ? 2px : 1px, seg.w * root.width);
            y: seg.event ? parent.height * 0.15 : 0;
            height: seg.event ? parent.height * 0.7 : parent.height;
            background: seg.event ? #f2b134 : #2d6db4;
        }
    }
    if root.head-shown: Rectangle {
        x: root.head * root.width - 1px;
        y: 22px;
        width: 2px;
        height: root.height - 22px;
        background: white;
        Rectangle {
            x: -4px;
            y: 0;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: white;
            border-width: root.scrub >= 0 || root.near-head ? 2px : 0px;
            border-color: Palette.accent-background;
        }
    }
    // The playhead's time, over the hour marks as in the Tapo app.
    if root.head-shown: Rectangle {
        property <length> w: bubble.preferred-width + 14px;
        x: max(2px, min(root.width - self.w - 2px, root.head * root.width - self.w / 2));
        y: 2px;
        width: self.w;
        height: 20px;
        border-radius: 10px;
        background: root.scrub >= 0 ? Palette.accent-background : #ffffff;
        bubble := Text {
            // While playing, the picture's own time (the playhead only
            // moves a pixel at a time); while dragging, where it would go.
            text: root.scrub < 0 && Bridge.player-time != "" ? Bridge.player-time : Bridge.tl-time-at(root.head);
            color: root.scrub >= 0 ? Palette.accent-foreground : #111418;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: root.scrub >= 0 || root.near-head ? MouseCursor.ew-resize
            : root.dragging ? MouseCursor.grabbing : MouseCursor.pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.dragging = false;
                root.scrubbed = false;
                if (root.near-head) {
                    root.scrub = max(0, min(1, self.mouse-x / root.width));
                }
            } else if (e.kind == PointerEventKind.up) {
                if (root.scrub >= 0) {
                    Bridge.tl-click(root.scrub);
                    root.scrub = -1;
                    root.scrubbed = true;
                } else if (root.dragging) {
                    Bridge.tl-drag-end();
                }
            }
        }
        moved => {
            if (self.pressed) {
                if (root.scrub >= 0) {
                    root.scrub = max(0, min(1, self.mouse-x / root.width));
                } else {
                    if (!root.dragging && abs(self.mouse-x - self.pressed-x) > 4px) {
                        root.dragging = true;
                    }
                    if (root.dragging) {
                        Bridge.tl-drag((self.mouse-x - self.pressed-x) / root.width);
                    }
                }
            }
        }
        clicked => {
            if (!root.dragging && !root.scrubbed) {
                Bridge.tl-click(self.mouse-x / root.width);
            }
        }
        scroll-event(e) => {
            if (e.delta-y > 0) {
                Bridge.tl-zoom(0.8, self.mouse-x / root.width);
            } else if (e.delta-y < 0) {
                Bridge.tl-zoom(1.25, self.mouse-x / root.width);
            }
            accept
        }
    }
}

component SpeedChip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    width: label.preferred-width + 16px;
    height: 26px;
    border-radius: 13px;
    background: root.active ? #ffffff : ta.has-hover ? #ffffff30 : transparent;
    label := Text {
        text: root.text;
        color: root.active ? #000000 : #ffffff;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component PlaybackPage inherits Rectangle {
    VerticalLayout {
        if !Bridge.fullscreen: PageHeader {
            title: Tr.nav-playback;
            VerticalLayout {
                alignment: center;
                RoundIconButton {
                    icon: Icons.side-panel;
                    label: Bridge.rec-side-hidden ? Tr.show-list : Tr.hide-list;
                    clicked => { Bridge.rec-side-hidden = !Bridge.rec-side-hidden; }
                }
            }
            if Bridge.hub-names.length > 1: VerticalLayout {
                alignment: center;
                ComboBox {
                    width: 220px;
                    model: Bridge.hub-names;
                    current-index <=> Bridge.rec-hub;
                    selected => { Bridge.rec-hub-changed(); }
                }
            }
            if Bridge.hub-busy || Bridge.cloud-busy: VerticalLayout {
                alignment: center;
                Spinner { width: 22px; height: 22px; indeterminate: true; }
            }
            VerticalLayout {
                alignment: center;
                RoundIconButton {
                    icon: Icons.refresh;
                    label: Tr.reload;
                    enabled: !Bridge.hub-busy;
                    clicked => { Bridge.connect-hub(); }
                }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: Bridge.fullscreen ? 0 : 28px;
            padding-right: Bridge.fullscreen ? 0 : 24px;
            padding-bottom: Bridge.fullscreen ? 0 : 20px;
            spacing: 20px;

            // The player and the timeline.
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 10px;
                video := Rectangle {
                    vertical-stretch: 1;
                    min-height: 200px;
                    // 16:9 when there's room, the same with or without a picture;
                    // all of the screen in full screen.
                    max-height: Bridge.fullscreen ? 100000px : self.width * 9 / 16;
                    preferred-height: Bridge.fullscreen ? 100000px : self.width * 9 / 16;
                    background: Bridge.fullscreen ? black : #0d0d0d;
                    border-radius: Bridge.fullscreen ? 0 : 14px;
                    clip: true;
                    Image {
                        width: parent.width * Bridge.video-zoom;
                        height: parent.height * Bridge.video-zoom;
                        x: (parent.width - self.width) / 2 + Bridge.video-pan-x * parent.width;
                        y: (parent.height - self.height) / 2 + Bridge.video-pan-y * parent.height;
                        source: Bridge.player-frame;
                        image-fit: contain;
                        visible: Bridge.player-open;
                    }
                    if !Bridge.player-open: VerticalLayout {
                        alignment: center;
                        spacing: 10px;
                        HorizontalLayout {
                            alignment: center;
                            Icon { commands: Icons.playback; width: 48px; height: 48px; color: #ffffff60; }
                        }
                        Text {
                            text: !Bridge.hub-connected ? Bridge.hub-message
                                : Bridge.tl-segments.length == 0 ? Tr.no-recordings-day
                                : Tr.click-timeline-hint;
                            color: #9a9a9a;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    // Before the first picture: a spinner in the middle.
                    if Bridge.player-open && !Bridge.player-has-frame && Bridge.player-busy: VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Spinner { width: 36px; height: 36px; indeterminate: true; }
                        }
                    }
                    // With a picture: it stays, with a small spinner in the corner.
                    if Bridge.player-open && Bridge.player-has-frame && Bridge.player-busy: Rectangle {
                        x: parent.width - self.width - 12px;
                        y: 12px;
                        width: 34px;
                        height: 34px;
                        border-radius: 17px;
                        background: #00000090;
                        Spinner { width: 22px; height: 22px; indeterminate: true; }
                    }
                    // Why it stopped, or the end of the day.
                    if Bridge.player-open && !Bridge.player-busy && Bridge.player-status != "": VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: min(status-text.preferred-width + 28px, video.width - 40px);
                                height: status-text.preferred-height + 14px;
                                border-radius: 10px;
                                background: #000000b0;
                                status-text := Text {
                                    width: parent.width - 28px;
                                    text: Bridge.player-status;
                                    color: #e0e0e0;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                    ZoomPanArea {
                        enabled: Bridge.player-open;
                        has-click: true;
                        single-clicked => { Bridge.player-toggle-pause(); }
                        double-clicked-unzoomed => { Bridge.toggle-fullscreen(); }
                    }
                    if Bridge.player-open && Bridge.video-zoom > 1.01: ZoomResetPill {
                        x: 14px;
                        y: Bridge.player-recording ? 52px : 14px;
                    }
                    if Bridge.player-recording: Rectangle {
                        x: 14px;
                        y: 14px;
                        width: rec-label.preferred-width + 34px;
                        height: 30px;
                        border-radius: 15px;
                        background: #000000b0;
                        Rectangle { x: 12px; width: 10px; height: 10px; border-radius: 5px; background: #e5484d; }
                        rec-label := Text {
                            x: 28px;
                            text: "REC " + Bridge.player-rec-time;
                            color: white;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    if Bridge.player-open && Bridge.fullscreen: Timeline {
                        overlay: true;
                        x: 16px;
                        width: parent.width - 32px;
                        y: parent.height - 54px - self.height - 6px;
                    }
                    if Bridge.player-open: Rectangle {
                        y: parent.height - self.height;
                        height: 54px;
                        background: @linear-gradient(0deg, #000000c0 0%, #00000000 100%);
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            padding-top: 8px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                RoundIconButton {
                                    width: 36px;
                                    height: 36px;
                                    icon: Bridge.player-paused || Bridge.player-ended ? Icons.play : Icons.pause;
                                    label: Bridge.player-paused ? Tr.play : Tr.pause;
                                    icon-color: white;
                                    base: #ffffff26;
                                    clicked => { Bridge.player-toggle-pause(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 36px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: sb-ta.pressed ? #ffffff40 : sb-ta.has-hover ? #ffffff2c : #ffffff18;
                                    Text {
                                        text: "-10s";
                                        color: white;
                                        font-size: 11px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    sb-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        changed has-hover => {
                                            if (self.has-hover) {
                                                Bridge.tip-text = Tr.skip-back;
                                                Bridge.tip-x = parent.absolute-position.x + parent.width / 2;
                                                Bridge.tip-y = parent.absolute-position.y;
                                            } else if (Bridge.tip-text == Tr.skip-back) {
                                                Bridge.tip-text = "";
                                            }
                                        }
                                        clicked => { Bridge.tip-text = ""; Bridge.player-skip(-10); }
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 36px;
                                    height: 28px;
                                    border-radius: 14px;
                                    background: sf-ta.pressed ? #ffffff40 : sf-ta.has-hover ? #ffffff2c : #ffffff18;
                                    Text {
                                        text: "+10s";
                                        color: white;
                                        font-size: 11px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    sf-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        changed has-hover => {
                                            if (self.has-hover) {
                                                Bridge.tip-text = Tr.skip-forward;
                                                Bridge.tip-x = parent.absolute-position.x + parent.width / 2;
                                                Bridge.tip-y = parent.absolute-position.y;
                                            } else if (Bridge.tip-text == Tr.skip-forward) {
                                                Bridge.tip-text = "";
                                            }
                                        }
                                        clicked => { Bridge.tip-text = ""; Bridge.player-skip(10); }
                                    }
                                }
                            }
                            Text {
                                text: Bridge.player-time;
                                color: white;
                                font-size: 15px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            for label[i] in Bridge.speed-labels: VerticalLayout {
                                alignment: center;
                                SpeedChip {
                                    text: label;
                                    active: Bridge.player-speed-index == i;
                                    clicked => { Bridge.player-speed(i); }
                                }
                            }
                            Rectangle { width: 6px; }
                            VerticalLayout {
                                alignment: center;
                                RoundIconButton {
                                    width: 36px;
                                    height: 36px;
                                    icon: Bridge.player-audio-on ? Icons.volume-on : Icons.volume-off;
                                    label: Bridge.player-audio-on ? Tr.mute-audio : Tr.listen-in;
                                    icon-color: Bridge.player-audio-on ? Palette.accent-foreground : white;
                                    base: Bridge.player-audio-on ? Palette.accent-background : #ffffff26;
                                    clicked => { Bridge.player-toggle-audio(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                RoundIconButton {
                                    width: 36px;
                                    height: 36px;
                                    icon: Icons.record;
                                    label: Bridge.player-recording ? Tr.stop-save-recording : Tr.record;
                                    icon-color: Bridge.player-recording ? #ff6b6b : white;
                                    base: Bridge.player-recording ? #e5484d50 : #ffffff26;
                                    clicked => { Bridge.player-record(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                RoundIconButton {
                                    width: 36px;
                                    height: 36px;
                                    icon: Icons.photo;
                                    label: Tr.take-photo;
                                    icon-color: white;
                                    base: #ffffff26;
                                    clicked => { Bridge.player-snapshot(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                RoundIconButton {
                                    width: 36px;
                                    height: 36px;
                                    icon: Bridge.fullscreen ? Icons.exit-fullscreen : Icons.fullscreen;
                                    label: Bridge.fullscreen ? Tr.leave-fullscreen : Tr.fullscreen;
                                    icon-color: white;
                                    base: #ffffff26;
                                    clicked => { Bridge.toggle-fullscreen(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                RoundIconButton {
                                    width: 36px;
                                    height: 36px;
                                    icon: Icons.close;
                                    label: Tr.close-player;
                                    icon-color: white;
                                    base: #ffffff26;
                                    clicked => { Bridge.player-stop(); }
                                }
                            }
                        }
                    }
                }
                if Bridge.hub-connected && !Bridge.fullscreen: HorizontalLayout {
                    spacing: 8px;
                    Timeline { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        RoundIconButton {
                            width: 32px;
                            height: 32px;
                            icon: Icons.zoom-in;
                            label: Tr.zoom-in;
                            clicked => { Bridge.tl-zoom(0.5, Bridge.tl-playhead >= 0 && Bridge.tl-playhead <= 1 ? Bridge.tl-playhead : 0.5); }
                        }
                        RoundIconButton {
                            width: 32px;
                            height: 32px;
                            icon: Icons.zoom-out;
                            label: Tr.zoom-out;
                            enabled: Bridge.tl-zoomed;
                            clicked => { Bridge.tl-zoom(2.0, Bridge.tl-playhead >= 0 && Bridge.tl-playhead <= 1 ? Bridge.tl-playhead : 0.5); }
                        }
                    }
                }
                if Bridge.player-open && !Bridge.fullscreen: HorizontalLayout {
                    spacing: 10px;
                    Text { text: Bridge.player-title; font-size: 15px; font-weight: 600; overflow: elide; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                if Bridge.downloads.length > 0 && !Bridge.fullscreen: VerticalLayout {
                    spacing: 4px;
                    Heading { text: Tr.saved-to-videos; }
                    for d in Bridge.downloads: HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout { alignment: center; Text { text: d.label; width: 230px; overflow: elide; } }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Muted { text: d.status; wrap: no-wrap; overflow: elide; }
                        }
                        if d.done: Button { text: Tr.open; clicked => { Bridge.open-file(d.path); } }
                        if d.done: Button { text: Tr.show-in-folder; clicked => { Bridge.show-in-folder(d.path); } }
                    }
                }
                // Takes what's left under the player, not a share of its room.
                if !Bridge.fullscreen: Rectangle { vertical-stretch: 0.001; }
            }

            // Camera, calendar and the day's recordings.
            if !Bridge.fullscreen && !Bridge.rec-side-hidden: Rectangle {
                width: 380px;
                border-radius: 14px;
                background: Palette.control-background;
                border-width: 1px;
                border-color: Palette.border;
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    if !Bridge.hub-connected: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        Muted { text: Bridge.hub-message; horizontal-alignment: center; wrap: word-wrap; }
                    }
                    if Bridge.hub-connected: ComboBox {
                        model: Bridge.paired-names;
                        current-index <=> Bridge.rec-camera;
                        selected => { Bridge.rec-camera-changed(); }
                    }
                    if Bridge.hub-connected: HorizontalLayout {
                        spacing: 4px;
                        RoundIconButton {
                            width: 32px;
                            height: 32px;
                            icon: Icons.chevron-left;
                            label: Tr.prev-month;
                            base: transparent;
                            clicked => { Bridge.change-month(-1); }
                        }
                        Text {
                            text: Bridge.rec-month;
                            font-weight: 600;
                            horizontal-stretch: 1;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        RoundIconButton {
                            width: 32px;
                            height: 32px;
                            icon: Icons.chevron-right;
                            label: Tr.next-month;
                            base: transparent;
                            enabled: !Bridge.rec-month-is-current;
                            clicked => { Bridge.change-month(1); }
                        }
                        Button { text: Tr.today; clicked => { Bridge.go-today(); } }
                    }
                    if Bridge.hub-connected: HorizontalLayout {
                        for name in Tr.weekdays: Text {
                            horizontal-stretch: 1;
                            text: name;
                            font-size: 11px;
                            color: Palette.foreground.transparentize(0.45);
                            horizontal-alignment: center;
                        }
                    }
                    if Bridge.hub-connected: VerticalLayout {
                        spacing: 2px;
                        for week in 6: HorizontalLayout {
                            spacing: 2px;
                            for day in 7: DayButton {
                                horizontal-stretch: 1;
                                chip: Bridge.rec-days[week * 7 + day];
                                clicked => { Bridge.pick-day(week * 7 + day); }
                            }
                        }
                    }
                    if Bridge.hub-connected: Rectangle { height: 1px; background: Palette.border; }
                    if Bridge.hub-connected: HorizontalLayout {
                        spacing: 8px;
                        Text { text: Bridge.rec-date; font-weight: 600; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Muted { text: Bridge.rec-list-title; vertical-alignment: center; }
                        if Bridge.recordings.length > 0 && !Bridge.batch-busy: Rectangle {
                            height: 24px;
                            width: sel-lbl.preferred-width + 16px;
                            border-radius: 12px;
                            background: Bridge.batch-mode ? Palette.accent-background
                                : sel-ta.has-hover ? Palette.foreground.transparentize(0.88) : Palette.foreground.transparentize(0.93);
                            sel-lbl := Text {
                                text: Bridge.batch-mode ? Tr.batch-done : Tr.batch-select;
                                font-size: 11px;
                                font-weight: 600;
                                color: Bridge.batch-mode ? Palette.accent-foreground : Palette.foreground.transparentize(0.2);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            sel-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { Bridge.batch-toggle-mode(); }
                            }
                        }
                    }
                    if Bridge.hub-connected: HorizontalLayout {
                        spacing: 4px;
                        for f[i] in Bridge.rec-filter-labels: Rectangle {
                            height: 26px;
                            horizontal-stretch: 1;
                            border-radius: 13px;
                            background: Bridge.rec-filter == i
                                ? Palette.accent-background
                                : fta.has-hover ? Palette.foreground.transparentize(0.88) : Palette.foreground.transparentize(0.93);
                            Text {
                                text: f;
                                font-size: 11px;
                                font-weight: 600;
                                color: Bridge.rec-filter == i ? Palette.accent-foreground : Palette.foreground.transparentize(0.2);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            fta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if (Bridge.rec-filter != i) {
                                        Bridge.rec-filter = i;
                                        Bridge.rec-filter-changed(i);
                                    }
                                }
                            }
                        }
                    }
                    if Bridge.hub-connected && Bridge.hour-bars.length == 24 && Bridge.hour-summary != "": ActivityChart {
                        bars: Bridge.hour-bars;
                        summary: Bridge.hour-summary;
                        jump(h) => { Bridge.jump-hour(h); }
                    }
                    if Bridge.hub-connected && (Bridge.batch-mode || Bridge.batch-busy): Rectangle {
                        height: 36px;
                        border-radius: 10px;
                        background: Palette.accent-background.transparentize(0.9);
                        border-width: 1px;
                        border-color: Palette.accent-background.transparentize(0.65);
                        if !Bridge.batch-busy: HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Button { text: Tr.batch-all; clicked => { Bridge.batch-select-all(); } }
                            }
                            VerticalLayout {
                                alignment: center;
                                Button {
                                    text: Tr.batch-clear;
                                    enabled: Bridge.batch-selected-count > 0;
                                    clicked => { Bridge.batch-clear(); }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            VerticalLayout {
                                alignment: center;
                                Button {
                                    text: Tr.batch-export-prefix + Bridge.batch-selected-count + Tr.batch-export-suffix;
                                    primary: true;
                                    enabled: Bridge.batch-selected-count > 0;
                                    clicked => { Bridge.batch-export(); }
                                }
                            }
                        }
                        if Bridge.batch-busy: HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Spinner { width: 16px; height: 16px; indeterminate: true; }
                            }
                            Text {
                                text: Bridge.batch-status;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            VerticalLayout {
                                alignment: center;
                                Button { text: Tr.cancel; clicked => { Bridge.batch-cancel(); } }
                            }
                        }
                    }
                    if Bridge.hub-connected: Rectangle {
                        vertical-stretch: 1;
                        ListView {
                            width: parent.width;
                            height: parent.height;
                            for r[i] in Bridge.recordings: ClipRow {
                                rec: r;
                                batch-mode: Bridge.batch-mode;
                                play => { Bridge.play-clip(i); }
                                save => { Bridge.download(i); }
                                toggle-select => { Bridge.batch-toggle-row(i); }
                            }
                        }
                        if Bridge.rec-loading: VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                Spinner { width: 28px; height: 28px; indeterminate: true; }
                            }
                        }
                        if !Bridge.rec-loading && Bridge.recordings.length == 0: Muted {
                            width: parent.width;
                            height: parent.height;
                            text: Bridge.rec-message != "" ? Bridge.rec-message : Tr.no-recordings-day;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    if Bridge.hub-connected && Bridge.recordings.length > 0: Muted { text: Bridge.rec-message; }
                }
            }
        }
    }
}

component FaceListRow inherits Rectangle {
    in property <FaceRow> face;
    callback clicked();
    height: 58px;
    border-radius: 10px;
    background: root.face.selected ? Palette.accent-background.transparentize(0.84)
        : ta.has-hover ? Palette.foreground.transparentize(0.94) : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 19px;
                clip: true;
                background: root.face.familiar ? Palette.accent-background.transparentize(0.82) : #e8a31730;
                if root.face.has-photo: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.face.photo;
                    image-fit: cover;
                }
                if !root.face.has-photo: Text {
                    text: root.face.initial;
                    font-size: 14px;
                    font-weight: 700;
                    color: root.face.familiar ? Palette.accent-background : #d48a00;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text {
                text: root.face.name;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.face.familiar ? Tr.people-familiar : Tr.people-stranger;
                    font-size: 11px;
                    font-weight: 600;
                    color: root.face.familiar ? Palette.accent-background : #d48a00;
                }
                if root.face.last-seen != "": Text {
                    text: "·  " + root.face.last-seen;
                    font-size: 11px;
                    color: Palette.foreground.transparentize(0.45);
                    overflow: elide;
                }
            }
        }
    }
}

component FaceTrackListRow inherits Rectangle {
    in property <FaceTrackRow> item;
    callback play();
    height: 60px;
    border-radius: 10px;
    background: ta.has-hover ? Palette.foreground.transparentize(0.94) : transparent;
    ta := TouchArea {
        enabled: root.item.playable;
        mouse-cursor: root.item.playable ? pointer : default;
        clicked => { root.play(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 19px;
                clip: true;
                background: root.item.familiar ? Palette.accent-background.transparentize(0.84) : #e8a31730;
                if root.item.has-photo: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.item.photo;
                    image-fit: cover;
                }
                if !root.item.has-photo: Icon {
                    width: 18px;
                    height: 18px;
                    commands: Icons.faces;
                    color: root.item.familiar ? Palette.accent-background : #d48a00;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 3px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.item.time;
                    font-size: 14px;
                    font-weight: 600;
                }
                if root.item.face-name != "": Text {
                    text: "·  " + root.item.face-name;
                    font-size: 13px;
                    font-weight: 600;
                    color: root.item.familiar ? Palette.accent-background : #d48a00;
                    overflow: elide;
                }
            }
            Text {
                text: root.item.camera + (root.item.clips != "" ? "  ·  " + root.item.clips : "");
                font-size: 12px;
                color: Palette.foreground.transparentize(0.4);
                overflow: elide;
            }
        }
        if root.item.playable: VerticalLayout {
            alignment: center;
            RoundIconButton {
                width: 34px;
                height: 34px;
                icon: Icons.play;
                label: Tr.people-watch;
                base: Palette.foreground.transparentize(0.93);
                clicked => { root.play(); }
            }
        }
    }
}

component PeoplePage inherits Rectangle {
    VerticalLayout {
        PageHeader {
            title: Tr.nav-people;
            subtitle: Tr.people-subtitle;
            if Bridge.hub-names.length > 1: VerticalLayout {
                alignment: center;
                ComboBox {
                    width: 220px;
                    model: Bridge.hub-names;
                    current-index <=> Bridge.rec-hub;
                    selected => { Bridge.faces-refresh(); }
                }
            }
            if Bridge.faces-loading || Bridge.face-track-loading: VerticalLayout {
                alignment: center;
                Spinner { width: 22px; height: 22px; indeterminate: true; }
            }
            VerticalLayout {
                alignment: center;
                RoundIconButton {
                    icon: Icons.refresh;
                    label: Tr.reload;
                    enabled: !Bridge.faces-loading;
                    clicked => { Bridge.faces-refresh(); }
                }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: 28px;
            padding-right: 24px;
            padding-bottom: 20px;
            spacing: 20px;

            // Left column: recognized people + inline rename / mark familiar editor.
            Rectangle {
                width: 350px;
                border-radius: 14px;
                background: Palette.control-background;
                border-width: 1px;
                border-color: Palette.border;
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    LineEdit {
                        text <=> Bridge.face-search;
                        placeholder-text: Tr.people-search-placeholder;
                        edited(t) => { Bridge.face-search-changed(t); }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        for f[i] in Bridge.face-filter-labels: Rectangle {
                            height: 28px;
                            horizontal-stretch: 1;
                            border-radius: 14px;
                            background: Bridge.face-filter == i
                                ? Palette.accent-background
                                : fta.has-hover ? Palette.foreground.transparentize(0.88) : Palette.foreground.transparentize(0.93);
                            Text {
                                text: f;
                                font-size: 12px;
                                font-weight: 600;
                                color: Bridge.face-filter == i ? Palette.accent-foreground : Palette.foreground.transparentize(0.2);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            fta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if (Bridge.face-filter != i) {
                                        Bridge.face-filter = i;
                                        Bridge.face-filter-changed(i);
                                    }
                                }
                            }
                        }
                    }
                    if Bridge.selected-face-id != "": HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: Tr.people-all-option;
                            clicked => { Bridge.face-select(""); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        ListView {
                            width: parent.width;
                            height: parent.height;
                            for f in Bridge.faces: FaceListRow {
                                face: f;
                                clicked => { Bridge.face-select(f.face-id); }
                            }
                        }
                        if Bridge.faces-loading && Bridge.faces.length == 0: VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                Spinner { width: 28px; height: 28px; indeterminate: true; }
                            }
                        }
                        if !Bridge.faces-loading && Bridge.faces.length == 0: Muted {
                            width: parent.width;
                            height: parent.height;
                            text: Bridge.faces-message;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    if Bridge.selected-face-id != "": Rectangle {
                        border-radius: 10px;
                        background: Palette.foreground.transparentize(0.96);
                        border-width: 1px;
                        border-color: Palette.border;
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            Text { text: Tr.people-edit-title; font-size: 13px; font-weight: 600; }
                            LineEdit {
                                text <=> Bridge.face-edit-name;
                                placeholder-text: Tr.people-name-placeholder;
                                accepted => { Bridge.face-save(); }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: Tr.people-mark-familiar;
                                        font-size: 12px;
                                        color: Palette.foreground.transparentize(0.25);
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Switch {
                                        checked <=> Bridge.face-edit-familiar;
                                    }
                                }
                            }
                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;
                                if Bridge.face-saving: VerticalLayout {
                                    alignment: center;
                                    Spinner { width: 16px; height: 16px; indeterminate: true; }
                                }
                                Button {
                                    text: Tr.save;
                                    primary: true;
                                    enabled: !Bridge.face-saving;
                                    clicked => { Bridge.face-save(); }
                                }
                            }
                        }
                    }
                }
            }

            // Right column: cross-camera face tracking timeline for the selected day.
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 14px;
                background: Palette.control-background;
                border-width: 1px;
                border-color: Palette.border;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: Bridge.selected-face-title != "" ? Bridge.selected-face-title : Tr.people-timeline-title;
                                font-size: 16px;
                                font-weight: 600;
                                overflow: elide;
                            }
                        }
                        RoundIconButton {
                            width: 32px;
                            height: 32px;
                            icon: Icons.chevron-left;
                            label: Tr.people-prev-day;
                            base: transparent;
                            clicked => { Bridge.face-track-day(-1); }
                        }
                        Text {
                            text: Bridge.face-track-date;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        RoundIconButton {
                            width: 32px;
                            height: 32px;
                            icon: Icons.chevron-right;
                            label: Tr.people-next-day;
                            base: transparent;
                            enabled: !Bridge.face-track-is-today;
                            clicked => { Bridge.face-track-day(1); }
                        }
                        Button {
                            text: Tr.today;
                            enabled: !Bridge.face-track-is-today;
                            clicked => { Bridge.face-track-day(0); }
                        }
                    }
                    Rectangle { height: 1px; background: Palette.border; }
                    Rectangle {
                        vertical-stretch: 1;
                        ListView {
                            width: parent.width;
                            height: parent.height;
                            for tr[i] in Bridge.face-tracks: FaceTrackListRow {
                                item: tr;
                                play => { Bridge.face-track-play(i); }
                            }
                        }
                        if Bridge.face-track-loading && Bridge.face-tracks.length == 0: VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                Spinner { width: 28px; height: 28px; indeterminate: true; }
                            }
                        }
                        if !Bridge.face-track-loading && Bridge.face-tracks.length == 0: Muted {
                            width: parent.width;
                            height: parent.height;
                            text: Bridge.face-track-message;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    if Bridge.face-tracks.length > 0 && Bridge.face-track-message != "": Muted {
                        text: Bridge.face-track-message;
                    }
                }
            }
        }
    }
}

// Settings, in the style of Windows 11's: cards of rows, each a title, a
// line about it and its control on the right.
component SettingsCard inherits Rectangle {
    border-radius: 10px;
    background: Palette.control-background;
    border-width: 1px;
    border-color: Palette.border;
    VerticalLayout {
        @children
    }
}

component SettingRow inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> description;
    // A line above it: every row but a card's first.
    in property <bool> divider: true;
    // A letter in a circle instead of the icon (the account's).
    in property <string> avatar;
    min-height: 62px;
    if root.divider: Rectangle {
        x: 16px;
        y: 0;
        width: parent.width - 32px;
        height: 1px;
        background: Palette.border;
    }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 12px;
        if root.avatar != "": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: Palette.accent-background;
                Text {
                    text: root.avatar;
                    color: Palette.accent-foreground;
                    font-size: 16px;
                    font-weight: 700;
                }
            }
        }
        if root.icon != "" && root.avatar == "": VerticalLayout {
            alignment: center;
            Icon { commands: root.icon; width: 22px; height: 22px; color: Palette.foreground.transparentize(0.25); }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: root.title; font-size: 14px; overflow: elide; }
            if root.description != "": Text {
                text: root.description;
                font-size: 12px;
                color: Palette.foreground.transparentize(0.45);
                wrap: word-wrap;
            }
        }
        @children
    }
}

component SettingsHeading inherits Text {
    font-size: 14px;
    font-weight: 600;
}

component SettingsPage inherits Rectangle {
    // The settings' column: no wider than reads well.
    property <length> column: min(880px, root.width - 28px - 24px - 14px);
    ScrollView {
        width: parent.width;
        height: parent.height;
        HorizontalLayout {
            padding-left: 28px;
            padding-right: 24px;
            padding-bottom: 32px;
            alignment: start;
            VerticalLayout {
                width: root.column;
                spacing: 8px;
                alignment: start;
                PageHeader { title: Tr.nav-settings; padding-left: 0px; padding-right: 0px; }

                SettingsHeading { text: Tr.sec-account; }
                SettingsCard {
                    SettingRow {
                        divider: false;
                        title: Bridge.cloud-signed-in ? Bridge.account-name : Tr.not-signed-in;
                        description: Bridge.cloud-signed-in ? Tr.signed-in-prefix + Bridge.account-server : Bridge.cloud-status;
                        avatar: Bridge.cloud-signed-in ? Bridge.account-initial : "";
                        icon: Bridge.cloud-signed-in ? "" : Icons.person;
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: Tr.sign-out;
                                enabled: Bridge.cloud-signed-in && !Bridge.cloud-busy;
                                clicked => { Bridge.cloud-sign-out(); }
                            }
                        }
                    }
                    SettingRow {
                        icon: Icons.refresh;
                        title: Tr.cameras-and-hubs;
                        description: Bridge.cloud-message != "" ? Bridge.cloud-message : Tr.cameras-hubs-desc;
                        if Bridge.cloud-busy: VerticalLayout {
                            alignment: center;
                            Spinner { width: 20px; height: 20px; indeterminate: true; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: Tr.update-list;
                                enabled: Bridge.cloud-signed-in && !Bridge.cloud-busy;
                                clicked => { Bridge.cloud-refresh(); }
                            }
                        }
                    }
                }
                Muted {
                    text: Tr.cloud-note;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                Rectangle { height: 8px; }

                SettingsHeading { text: Tr.cameras-section; }
                SettingsCard {
                    if Bridge.cameras.length == 0: SettingRow {
                        divider: false;
                        icon: Icons.video;
                        title: Tr.no-cameras-title;
                        description: Tr.no-cameras-settings-desc;
                    }
                    for c[i] in Bridge.cameras: SettingRow {
                        divider: i > 0;
                        icon: Icons.video;
                        title: c.name;
                        description: c.detail;
                        VerticalLayout {
                            alignment: center;
                            RoundIconButton {
                                icon: Icons.chevron-up;
                                label: c.name;
                                enabled: i > 0;
                                clicked => { Bridge.move-camera(c.id, -1); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            RoundIconButton {
                                icon: Icons.chevron-down;
                                label: c.name;
                                enabled: i < Bridge.cameras.length - 1;
                                clicked => { Bridge.move-camera(c.id, 1); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button { text: Tr.edit; clicked => { Bridge.edit-camera(c.id); } }
                        }
                        VerticalLayout {
                            alignment: center;
                            RoundIconButton {
                                icon: Icons.close;
                                label: c.name;
                                clicked => { Bridge.delete-camera(c.id); }
                            }
                        }
                    }
                    if Bridge.cam-editing >= 0: Rectangle {
                        Rectangle { x: 16px; y: 0; width: parent.width - 32px; height: 1px; background: Palette.border; }
                        VerticalLayout {
                            padding: 18px;
                            spacing: 10px;
                            Text {
                                text: Bridge.cam-editing == 0 ? Tr.add-camera : Tr.edit-camera;
                                font-size: 14px;
                                font-weight: 600;
                            }
                            Field {
                                label: Tr.tapo-camera;
                                ComboBox { width: 280px; model: Bridge.cloud-camera-labels; current-index <=> Bridge.cam-cloud; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Field {
                                label: Tr.name-label;
                                LineEdit { text <=> Bridge.cam-name; placeholder-text: Tr.name-placeholder; width: 280px; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Field {
                                label: Tr.live-stream-label;
                                ComboBox { width: 280px; model: Bridge.quality-labels; current-index <=> Bridge.cam-quality; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Muted {
                                text: Tr.stream-quality-note;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            if Bridge.cam-error != "": Text { text: Bridge.cam-error; color: #e5484d; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                Button { text: Tr.cancel; clicked => { Bridge.cam-editing = -1; } }
                                Button { text: Tr.save; primary: true; clicked => { Bridge.save-camera(); } }
                            }
                        }
                    }
                    if Bridge.cam-editing < 0 && Bridge.cameras.length > 0: SettingRow {
                        title: Tr.add-camera;
                        description: Tr.add-camera-desc;
                        VerticalLayout {
                            alignment: center;
                            Button { text: Tr.add; clicked => { Bridge.new-camera(); } }
                        }
                    }
                }
                Rectangle { height: 8px; }

                SettingsHeading { text: Tr.sec-appearance; }
                SettingsCard {
                    SettingRow {
                        divider: false;
                        icon: Icons.settings;
                        title: Tr.appearance-title;
                        description: Tr.appearance-desc;
                        VerticalLayout {
                            alignment: center;
                            ComboBox {
                                width: 220px;
                                model: Tr.appearance-labels;
                                current-index <=> Bridge.theme-index;
                                selected => { Bridge.save-settings(); }
                            }
                        }
                    }
                    SettingRow {
                        icon: Icons.globe;
                        title: Tr.language-title;
                        description: Tr.language-desc;
                        VerticalLayout {
                            alignment: center;
                            ComboBox {
                                width: 220px;
                                model: Tr.language-labels;
                                current-index <=> Bridge.language-index;
                                selected => { Bridge.save-settings(); }
                            }
                        }
                    }
                    SettingRow {
                        icon: Icons.grid;
                        title: Tr.renderer-title;
                        description: Tr.renderer-desc;
                        VerticalLayout {
                            alignment: center;
                            ComboBox {
                                width: 220px;
                                model: Tr.renderer-labels;
                                current-index <=> Bridge.renderer-index;
                                selected => { Bridge.save-settings(); }
                            }
                        }
                    }
                    SettingRow {
                        icon: Icons.folder;
                        title: Tr.settings-file;
                        description: Bridge.config-path;
                        VerticalLayout {
                            alignment: center;
                            Button { text: Tr.show-in-folder; clicked => { Bridge.show-in-folder(Bridge.config-path); } }
                        }
                    }
                }
                Rectangle { height: 8px; }

                SettingsHeading { text: Tr.sec-shortcuts; }
                SettingsCard {
                    for s[i] in [
                        { keys: "Ctrl + 1–5", desc: Tr.sc-nav },
                        { keys: "1–9", desc: Tr.sc-cam },
                        { keys: "PgUp / PgDn", desc: Tr.sc-cycle-cam },
                        { keys: "Space", desc: Tr.sc-space },
                        { keys: "← / →", desc: Tr.sc-arrows },
                        { keys: "[ / ]", desc: Tr.sc-speed },
                        { keys: "M", desc: Tr.sc-mute },
                        { keys: "S", desc: Tr.sc-snap },
                        { keys: "R", desc: Tr.sc-rec },
                        { keys: "Scroll / 0", desc: Tr.sc-zoom },
                        { keys: "F11 / Esc", desc: Tr.sc-full },
                    ]: Rectangle {
                        min-height: 44px;
                        if i > 0: Rectangle {
                            x: 16px;
                            y: 0;
                            width: parent.width - 32px;
                            height: 1px;
                            background: Palette.border;
                        }
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 14px;
                            VerticalLayout {
                                alignment: center;
                                width: 112px;
                                HorizontalLayout {
                                    alignment: start;
                                    Rectangle {
                                        height: 26px;
                                        width: k-lbl.preferred-width + 18px;
                                        border-radius: 6px;
                                        background: Palette.foreground.transparentize(0.93);
                                        border-width: 1px;
                                        border-color: Palette.border;
                                        k-lbl := Text {
                                            text: s.keys;
                                            font-size: 12px;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            Text {
                                text: s.desc;
                                font-size: 13px;
                                color: Palette.foreground.transparentize(0.2);
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                Rectangle { height: 8px; }

                SettingsHeading { text: Tr.sec-about; }
                SettingsCard {
                    SettingRow {
                        divider: false;
                        title: "Tapas " + Bridge.app-version;
                        description: Bridge.update-status != "" ? Bridge.update-status : Tr.about-default;
                        if Bridge.update-busy: VerticalLayout {
                            alignment: center;
                            Spinner { width: 20px; height: 20px; indeterminate: true; }
                        }
                        if Bridge.update-available: VerticalLayout {
                            alignment: center;
                            Button {
                                text: Tr.update-to-prefix + Bridge.update-version;
                                primary: true;
                                enabled: !Bridge.update-busy;
                                clicked => { Bridge.install-update(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: Tr.check-updates;
                                enabled: !Bridge.update-busy;
                                clicked => { Bridge.check-update(); }
                            }
                        }
                    }
                    SettingRow {
                        icon: Icons.download;
                        title: Tr.auto-update-title;
                        description: Tr.auto-update-desc;
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                checked <=> Bridge.check-updates;
                                toggled => { Bridge.check-updates-changed(); }
                            }
                        }
                    }
                }
                // Long text wraps well only outside the cards' rows.
                Muted {
                    text: Tr.credits-note;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    padding-top: 8px;
                    AboutSlint { width: 150px; }
                }
            }
        }
    }
}

component WindowControls inherits Rectangle {
    width: 138px;
    height: 32px;
    background: transparent;

    property <brush> glyph: Bridge.window-active
        ? Palette.foreground.transparentize(0.08)
        : Palette.foreground.transparentize(0.55);

    HorizontalLayout {
        spacing: 0px;

        // Minimize
        Rectangle {
            width: 46px;
            height: 32px;
            background: min-ta.pressed ? Palette.foreground.transparentize(0.84)
                : min-ta.has-hover ? Palette.foreground.transparentize(0.91) : transparent;
            animate background { duration: 90ms; }
            accessible-role: button;
            accessible-label: Tr.win-minimize;
            accessible-action-default => { Bridge.window-minimize(); }

            Path {
                width: 10px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                viewbox-width: 10;
                viewbox-height: 10;
                stroke: root.glyph;
                stroke-width: 1px;
                fill: transparent;
                commands: "M 0.5 5 H 9.5";
            }
            min-ta := TouchArea {
                clicked => { Bridge.window-minimize(); }
            }
        }

        // Maximize / Restore (WM_NCHITTEST returns HTMAXBUTTON here so Windows 11 Snap Layouts work)
        Rectangle {
            width: 46px;
            height: 32px;
            property <bool> hot: Bridge.max-btn-hovered || max-ta.has-hover;
            property <bool> down: Bridge.max-btn-pressed || max-ta.pressed;
            background: self.down ? Palette.foreground.transparentize(0.84)
                : self.hot ? Palette.foreground.transparentize(0.91) : transparent;
            animate background { duration: 90ms; }
            accessible-role: button;
            accessible-label: Bridge.window-maximized ? Tr.win-restore : Tr.win-maximize;
            accessible-action-default => { Bridge.window-toggle-maximize(); }

            Path {
                width: 10px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                viewbox-width: 10;
                viewbox-height: 10;
                stroke: root.glyph;
                stroke-width: 1px;
                fill: transparent;
                commands: Bridge.window-maximized
                    ? "M 0.5 3.5 A 1 1 0 0 1 1.5 2.5 H 6.5 A 1 1 0 0 1 7.5 3.5 V 8.5 A 1 1 0 0 1 6.5 9.5 H 1.5 A 1 1 0 0 1 0.5 8.5 Z M 2.5 2.5 V 1.5 A 1 1 0 0 1 3.5 0.5 H 8.5 A 1 1 0 0 1 9.5 1.5 V 6.5 A 1 1 0 0 1 8.5 7.5 H 7.5"
                    : "M 0.5 1.5 A 1 1 0 0 1 1.5 0.5 H 8.5 A 1 1 0 0 1 9.5 1.5 V 8.5 A 1 1 0 0 1 8.5 9.5 H 1.5 A 1 1 0 0 1 0.5 8.5 Z";
            }
            max-ta := TouchArea {
                clicked => { Bridge.window-toggle-maximize(); }
            }
        }

        // Close
        Rectangle {
            width: 46px;
            height: 32px;
            background: close-ta.pressed ? #b3261a
                : close-ta.has-hover ? #c42b1c : transparent;
            animate background { duration: 90ms; }
            accessible-role: button;
            accessible-label: Tr.win-close;
            accessible-action-default => { Bridge.window-close(); }

            Path {
                width: 10px;
                height: 10px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                viewbox-width: 10;
                viewbox-height: 10;
                stroke: close-ta.has-hover || close-ta.pressed ? white : root.glyph;
                stroke-width: 1px;
                stroke-line-cap: round;
                fill: transparent;
                commands: "M 0.5 0.5 L 9.5 9.5 M 9.5 0.5 L 0.5 9.5";
            }
            close-ta := TouchArea {
                clicked => { Bridge.window-close(); }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Tapas";
    icon: @image-url("../assets/app-icon.png");

    // Gives the keyboard back to the shortcuts (F11, Esc, arrow keys): a
    // focused text box that disappears with its page would otherwise leave
    // nothing focused.
    public function focus-keys() {
        keys.focus();
    }

    // 0 follows Windows, 1 light, 2 dark.
    public function set-theme(index: int) {
        Palette.color-scheme = index == 1 ? ColorScheme.light : index == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 760px;
    min-height: 480px;
    background: Bridge.fullscreen ? black : Palette.background;
    forward-focus: keys;

    keys := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.text == Key.F11) {
                Bridge.toggle-fullscreen();
                return accept;
            }
            if (event.text == Key.Escape) {
                Bridge.escape();
                return accept;
            }
            if (!Bridge.cloud-signed-in) {
                return reject;
            }
            // Ctrl+1..5: quick navigation across pages.
            if (event.modifiers.control && !event.modifiers.alt) {
                if (event.text == "1") { Bridge.navigate(Page.home); return accept; }
                if (event.text == "2") { Bridge.navigate(Page.live); return accept; }
                if (event.text == "3") { Bridge.navigate(Page.recordings); return accept; }
                if (event.text == "4" && Bridge.hubs.length > 0) { Bridge.navigate(Page.people); return accept; }
                if (event.text == "5") { Bridge.navigate(Page.settings); return accept; }
                return reject;
            }
            if (!event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta) {
                if (event.text == "m" || event.text == "M") {
                    if (Bridge.page == Page.single) {
                        Bridge.single-toggle-audio();
                        return accept;
                    }
                    if (Bridge.page == Page.recordings && Bridge.player-open) {
                        Bridge.player-toggle-audio();
                        return accept;
                    }
                }
                if (event.text == "s" || event.text == "S") {
                    if (Bridge.page == Page.single) {
                        Bridge.snapshot();
                        return accept;
                    }
                    if (Bridge.page == Page.recordings && Bridge.player-open) {
                        Bridge.player-snapshot();
                        return accept;
                    }
                }
                if (event.text == "r" || event.text == "R") {
                    if (Bridge.page == Page.single) {
                        Bridge.single-record();
                        return accept;
                    }
                    if (Bridge.page == Page.recordings && Bridge.player-open) {
                        Bridge.player-record();
                        return accept;
                    }
                }
                if (event.text == "0" && Bridge.video-zoom > 1.01
                    && (Bridge.page == Page.single || (Bridge.page == Page.recordings && Bridge.player-open)))
                {
                    Bridge.reset-zoom();
                    return accept;
                }
                if (Bridge.page == Page.recordings && Bridge.player-open) {
                    if (event.text == " ") {
                        Bridge.player-toggle-pause();
                        return accept;
                    }
                    if (event.text == Key.LeftArrow) {
                        Bridge.player-skip(event.modifiers.shift ? -30 : -10);
                        return accept;
                    }
                    if (event.text == Key.RightArrow) {
                        Bridge.player-skip(event.modifiers.shift ? 30 : 10);
                        return accept;
                    }
                    if (event.text == "[") {
                        Bridge.player-step-speed(-1);
                        return accept;
                    }
                    if (event.text == "]") {
                        Bridge.player-step-speed(1);
                        return accept;
                    }
                }
                if (Bridge.page == Page.home || Bridge.page == Page.live) {
                    if (event.text == "1") { Bridge.open-camera-slot(0); return accept; }
                    if (event.text == "2") { Bridge.open-camera-slot(1); return accept; }
                    if (event.text == "3") { Bridge.open-camera-slot(2); return accept; }
                    if (event.text == "4") { Bridge.open-camera-slot(3); return accept; }
                    if (event.text == "5") { Bridge.open-camera-slot(4); return accept; }
                    if (event.text == "6") { Bridge.open-camera-slot(5); return accept; }
                    if (event.text == "7") { Bridge.open-camera-slot(6); return accept; }
                    if (event.text == "8") { Bridge.open-camera-slot(7); return accept; }
                    if (event.text == "9") { Bridge.open-camera-slot(8); return accept; }
                }
                if (Bridge.page == Page.single) {
                    if (event.text == Key.PageUp && Bridge.single-can-switch) {
                        Bridge.single-step-camera(-1);
                        return accept;
                    }
                    if (event.text == Key.PageDown && Bridge.single-can-switch) {
                        Bridge.single-step-camera(1);
                        return accept;
                    }
                }
                if (Bridge.page == Page.single && Bridge.single-ptz) {
                    if (event.text == Key.LeftArrow) {
                        Bridge.ptz-move(-Bridge.ptz-step, 0);
                        return accept;
                    }
                    if (event.text == Key.RightArrow) {
                        Bridge.ptz-move(Bridge.ptz-step, 0);
                        return accept;
                    }
                    if (event.text == Key.UpArrow) {
                        Bridge.ptz-move(0, Bridge.ptz-step);
                        return accept;
                    }
                    if (event.text == Key.DownArrow) {
                        Bridge.ptz-move(0, -Bridge.ptz-step);
                        return accept;
                    }
                }
            }
            return reject;
        }

        if !Bridge.cloud-signed-in: SignInScreens { }
        if Bridge.cloud-signed-in: HorizontalLayout {
            if !Bridge.fullscreen && Bridge.page != Page.single: Sidebar { }
            VerticalLayout {
                horizontal-stretch: 1;
                if Bridge.page == Page.home: HomePage { vertical-stretch: 1; }
                if Bridge.page == Page.live: LivePage { vertical-stretch: 1; }
                if Bridge.page == Page.single: SinglePage { vertical-stretch: 1; }
                if Bridge.page == Page.recordings: PlaybackPage { vertical-stretch: 1; }
                if Bridge.page == Page.people: PeoplePage { vertical-stretch: 1; }
                if Bridge.page == Page.settings: SettingsPage { vertical-stretch: 1; }
            }
        }
    }

    if Bridge.status-text != "": FloatingToast {
        max-w: min(580px, parent.width - 32px);
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - (Bridge.page == Page.recordings && Bridge.player-open ? 72px : 22px);
    }

    if Bridge.tip-text != "": Rectangle {
        property <length> w: tip-lbl.preferred-width + 18px;
        x: max(8px, min(parent.width - self.w - 8px, Bridge.tip-x - self.w / 2));
        y: Bridge.tip-y > 46px ? Bridge.tip-y - 34px : Bridge.tip-y + 46px;
        width: self.w;
        height: 28px;
        border-radius: 7px;
        background: #1b1b1fe8;
        border-width: 1px;
        border-color: #ffffff28;
        tip-lbl := Text {
            text: Bridge.tip-text;
            color: white;
            font-size: 12px;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if Bridge.custom-chrome && !Bridge.fullscreen: WindowControls {
        x: parent.width - self.width;
        y: 0;
    }
}
